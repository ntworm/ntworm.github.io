---
/**
 * GaussianViewer — client-side WebGL2 viewer for `.splat` files.
 *
 * Loads gsplat.js (dylanebert) from CDN on first user interaction (click
 * "Load viewer"). Until then, the user sees a poster + a single CTA. This
 * keeps the case page lightweight — gsplat.js (~150 KB) only loads when
 * the user opts in.
 *
 * Renderer API (gsplat.js v1.2.x):
 *   SPLAT.Scene + SPLAT.Camera + SPLAT.WebGLRenderer + SPLAT.OrbitControls
 *   SPLAT.Loader.LoadAsync(url, scene, onProgress)
 *
 * Props:
 *   src       — root-relative path to the .splat file (e.g. /splats/foo/model.splat)
 *   hint      — caption shown beneath the viewer (e.g. "drag to orbit · scroll to zoom")
 *   poster    — optional root-relative image to show as poster before loading
 */
interface Props {
  src: string;
  hint?: string;
  poster?: string;
}

const { src, hint, poster } = Astro.props;
const splatLibUrl = 'https://esm.sh/gsplat';
---

<div class="gs-viewer" data-src={src} data-splat-lib={splatLibUrl}>
  <div class="gs-viewer__stage">
    <canvas class="gs-viewer__canvas" aria-label="3D Gaussian splat viewer"></canvas>
    {poster && <img class="gs-viewer__poster" src={poster} alt="" aria-hidden="true" />}
    <div class="gs-viewer__overlay" role="status" aria-live="polite">
      <button class="gs-viewer__load" type="button">
        <span class="gs-viewer__load-label">Load 3D viewer</span>
        <span class="gs-viewer__load-meta">WebGL2 · ~71 MB · GPU required</span>
      </button>
      <div class="gs-viewer__progress" hidden>
        <div class="gs-viewer__progress-bar"></div>
        <span class="gs-viewer__progress-text">0%</span>
      </div>
      <p class="gs-viewer__error" hidden></p>
    </div>
  </div>
  {hint && <p class="gs-viewer__hint mono">{hint}</p>}
</div>



<script>
  // gsplat.js exposes a namespace under window.SPLAT. We use a Blob URL
  // wrapper so the browser handles the CDN import natively and Vite's
  // __VITE_PRELOAD__ helper is bypassed.
  async function loadEngine(splatLibUrl: string): Promise<void> {
    if (window.__gsStartViewer) return;
    const code = [
      "import * as SPLAT from '" + splatLibUrl + "';",
      "window.__gsStartViewer = function(src, stage, canvas) {",
      "  const scene = new SPLAT.Scene();",
      "  const camera = new SPLAT.Camera();",
      "  const renderer = new SPLAT.WebGLRenderer();",
      "  renderer.canvas.style.cssText = 'width:100%;height:100%;display:block;position:absolute;inset:0';",
      "  stage.appendChild(renderer.canvas);",
      "  const controls = new SPLAT.OrbitControls(camera, renderer.canvas);",
      "  return SPLAT.Loader.LoadAsync(src, scene, function(pct) {",
      "    const wrap = canvas.parentElement && canvas.parentElement.parentElement;",
      "    const bar = wrap && wrap.querySelector('.gs-viewer__progress-bar');",
      "    const text = wrap && wrap.querySelector('.gs-viewer__progress-text');",
      "    if (bar) bar.style.width = (pct * 100) + '%';",
      "    if (text) text.textContent = Math.round(pct * 100) + '% \\u00b7 streaming';",
      "  }).then(function() {",
      "    console.log('[gs] splat loaded, starting rAF');",
      "    const frame = function() {",
      "      controls.update();",
      "      renderer.render(scene, camera);",
      "      requestAnimationFrame(frame);",
      "    };",
      "    requestAnimationFrame(frame);",
      "    window.__gsLoaded = true;",
      "  }).catch(function(e){",
      "    console.error('[gs] loader failed', e);",
      "    window.__gsLoaded = false;",
      "    window.__gsLoadError = e;",
      "  });",
      "};",
      "window.__gsModulesReadyResolve();",
    ].join('\n');
    const blob = new Blob([code], { type: 'text/javascript' });
    const blobUrl = URL.createObjectURL(blob);
    window.__gsModulesReady = new Promise<void>((resolve) => {
      window.__gsModulesReadyResolve = resolve;
    });
    const script = document.createElement('script');
    script.type = 'module';
    script.src = blobUrl;
    script.onerror = () => window.__gsModulesReadyResolve();
    document.head.appendChild(script);
    await window.__gsModulesReady;
    URL.revokeObjectURL(blobUrl);
  }

  async function loadViewer(viewer: HTMLElement): Promise<void> {
    const src = viewer.dataset.src!;
    const splatLibUrl = viewer.dataset.splatLib!;
    const overlay = viewer.querySelector<HTMLElement>('.gs-viewer__overlay');
    const loadBtn = viewer.querySelector<HTMLButtonElement>('.gs-viewer__load');
    const progress = viewer.querySelector<HTMLElement>('.gs-viewer__progress');
    const progressBar = viewer.querySelector<HTMLElement>('.gs-viewer__progress-bar');
    const progressText = viewer.querySelector<HTMLElement>('.gs-viewer__progress-text');
    const errorEl = viewer.querySelector<HTMLElement>('.gs-viewer__error');
    const poster = viewer.querySelector<HTMLImageElement>('.gs-viewer__poster');
    const canvas = viewer.querySelector<HTMLCanvasElement>('.gs-viewer__canvas');
    const stage = viewer.querySelector<HTMLElement>('.gs-viewer__stage');

    if (!loadBtn || !overlay || !progress || !progressBar || !progressText || !errorEl || !canvas || !stage) return;

    loadBtn.disabled = true;
    loadBtn.querySelector('.gs-viewer__load-label')!.textContent = 'Loading engine…';
    progress.hidden = false;
    errorEl.hidden = true;

    function setProgress(pct: number, label?: string) {
      progressBar.style.width = `${pct}%`;
      progressText.textContent = label ?? `${Math.round(pct)}%`;
    }

    try {
      await loadEngine(splatLibUrl);
      setProgress(5, 'Engine ready');

      loadBtn.querySelector('.gs-viewer__load-label')!.textContent = 'Streaming splat…';

      await window.__gsStartViewer(src, stage, canvas);

      // Hide overlay AFTER the first real render frame so we never see a flash
      // of an empty canvas behind the loading UI.
      await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));

      if (poster) poster.style.display = 'none';
      overlay.hidden = true;
      overlay.style.display = 'none';
    } catch (err) {
      console.error('[gs-viewer] failed', err);
      errorEl.textContent = `Viewer failed to load: ${err instanceof Error ? err.message : String(err)}. Try a desktop browser with WebGL2.`;
      errorEl.hidden = false;
      loadBtn.disabled = false;
      loadBtn.querySelector('.gs-viewer__load-label')!.textContent = 'Retry';
      progress.hidden = true;
    }
  }

  function gsAttachAll(): void {
    document.querySelectorAll<HTMLElement>('.gs-viewer').forEach((viewer) => {
      if (viewer.dataset.gsAttached === '1') return;
      viewer.dataset.gsAttached = '1';
      const btn = viewer.querySelector<HTMLButtonElement>('.gs-viewer__load');
      btn?.addEventListener('click', () => loadViewer(viewer), { once: true });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', gsAttachAll);
  } else {
    gsAttachAll();
  }
  // Re-attach after Astro view-transitions page swaps.
  document.addEventListener('astro:page-load', gsAttachAll);
</script>

<style>
  .gs-viewer {
    --bg: #050505;
    --fg: #f5e8d0;
    --accent: #ff7a18;
    position: relative;
    width: 100%;
    margin: 0 0 2rem;
  }

  .gs-viewer__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg);
    overflow: hidden;
    border: 1px solid rgba(245, 232, 208, 0.08);
  }

  .gs-viewer__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .gs-viewer__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 240ms ease;
    pointer-events: none;
  }

  .gs-viewer__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.25) 0%, rgba(5, 5, 5, 0.55) 100%);
    text-align: center;
    padding: 1.5rem;
  }

  .gs-viewer__overlay[hidden] {
    display: none !important;
  }

  .gs-viewer__load {
    appearance: none;
    border: 1px solid var(--accent);
    background: rgba(5, 5, 5, 0.65);
    color: var(--fg);
    padding: 0.85rem 1.6rem;
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    backdrop-filter: blur(8px);
  }

  .gs-viewer__load:hover:not(:disabled) {
    background: rgba(255, 122, 24, 0.18);
    transform: translateY(-1px);
  }

  .gs-viewer__load:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .gs-viewer__load-label {
    font-size: 0.95rem;
  }

  .gs-viewer__load-meta {
    font-size: 0.7rem;
    opacity: 0.7;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .gs-viewer__progress {
    width: min(320px, 80%);
    height: 4px;
    background: rgba(245, 232, 208, 0.12);
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .gs-viewer__progress-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: var(--accent);
    transition: width 200ms ease;
  }

  .gs-viewer__progress-text {
    position: absolute;
    right: -3.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.72rem;
    color: var(--fg);
    opacity: 0.75;
    min-width: 3rem;
    text-align: left;
  }

  .gs-viewer__error {
    color: #e6324a;
    background: rgba(5, 5, 5, 0.75);
    padding: 0.6rem 1rem;
    border: 1px solid rgba(230, 50, 74, 0.35);
    font-size: 0.85rem;
    max-width: 480px;
  }

  .gs-viewer__hint {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    opacity: 0.7;
    color: var(--fg);
  }
</style>