---
import WorkEntry from './WorkEntry.astro';
import dimensionsData from '../../data/asset-dimensions.json';
import { localeFromPath, localizePath } from '../../i18n/locales.mjs';

interface Props {
  mode?: 'overview' | 'detail';
  presentation: {
    featured: Parameters<typeof WorkEntry>[0]['project'][];
    more: Parameters<typeof WorkEntry>[0]['project'][];
    overview: Parameters<typeof WorkEntry>[0]['project'][];
    audiovisual: {
      featured: Parameters<typeof WorkEntry>[0]['project'][];
      more: Parameters<typeof WorkEntry>[0]['project'][];
    };
  };
}

const { presentation, mode = 'detail' } = Astro.props;
const isOverview = mode === 'overview';
const { featured, more } = presentation.audiovisual;
const locale = localeFromPath(Astro.url);
const copy = {
  en: {
    eyebrow: 'Selected projects',
    title: 'Sound, music, code, and moving image.',
    titleLines: ['Sound, music,', 'code,', 'and moving image.'],
    intro: 'Selected work across cinema, television, music, generative art, performance, and tools.',
    practiceLabel: 'Practice areas',
    practice: [
      { label: 'Film & television', href: '/#work' },
      { label: 'Music & live sound', href: '/#work' },
      { label: 'Musical interfaces', href: '/#code' },
      { label: 'Generative art', href: '/#generative' },
    ],
    spotlightLabel: 'Project spotlight',
    spotlightFallbackRole: 'Work',
    selectedEyebrow: 'Sound & audiovisual',
    selectedTitle: 'Sound for film, music, and the stage.',
    moreEyebrow: 'More audiovisual work',
    moreTitle: 'Further work in film and television.',
    projectLinksLabel: 'Explore the selected projects',
  },
  pt: {
    eyebrow: 'Projetos selecionados',
    title: 'Som, música, código e imagem.',
    titleLines: ['Som, música,', 'código', 'e imagem.'],
    intro: 'Uma seleção de trabalhos entre cinema, televisão, música, arte generativa, performance e ferramentas.',
    practiceLabel: 'Áreas de atuação',
    practice: [
      { label: 'Cinema e televisão', href: '/#work' },
      { label: 'Música e som ao vivo', href: '/#work' },
      { label: 'Interfaces musicais', href: '/#code' },
      { label: 'Arte generativa', href: '/#generative' },
    ],
    spotlightLabel: 'Projetos em destaque',
    spotlightFallbackRole: 'Trabalho',
    selectedEyebrow: 'Som e audiovisual',
    selectedTitle: 'Som para cinema, música e palco.',
    moreEyebrow: 'Mais trabalhos audiovisuais',
    moreTitle: 'Outros trabalhos em cinema e televisão.',
    projectLinksLabel: 'Explorar os projetos selecionados',
  },
}[locale];

const spotlightProjects = presentation.overview.filter((project) => project.media.cover);
const firstFeaturedCoverIndex = featured.findIndex((project) => project.media.cover);
const dimensionsByProject = dimensionsData as Record<string, Array<{ file: string; w: number; h: number }>>;

function coverDimensions(project: (typeof spotlightProjects)[number]) {
  const filename = project.media.cover?.split('/').pop();
  return dimensionsByProject[project.id]?.find((dimension) => dimension.file === filename);
}
---

<section id={isOverview ? 'projects' : 'work'} class="portfolio-work wrap" data-portfolio-chapter={isOverview ? 'projects' : 'work'}>
  {isOverview && (<header class="portfolio-work__header">
    <div class="portfolio-work__hero">
      <div class="portfolio-work__hero-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2
          class="portfolio-work__title"
          data-work-title-reveal
          aria-label={copy.title}
        >
          {copy.titleLines.map((line) => (
            <span class="portfolio-work__title-line"><span>{line}</span></span>
          ))}
        </h2>
        <p>{copy.intro}</p>
        <ul class="portfolio-work__practice" aria-label={copy.practiceLabel}>
          {copy.practice.map((area) => <li><a href={localizePath(area.href, locale)}>{area.label}</a></li>)}
        </ul>
      </div>

      <div
        class="portfolio-work__spotlight"
        role="group"
        aria-label={copy.spotlightLabel}
        data-spotlight
      >
        {spotlightProjects.map((project, index) => project && (
          <a
            href={localizePath(`/work/${project.id}`, locale)}
            class="work-spotlight-cell"
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
            tabindex={index === 0 ? 0 : -1}
            data-spotlight-slide
            data-spotlight-project={project.id}
            aria-label={`${project.data.title} — ${project.data.role ?? copy.spotlightFallbackRole} (${project.data.year})`}
          >
            <img
              src={index === 0 ? project.media.cover : undefined}
              data-src={project.media.cover}
              alt=""
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              width={coverDimensions(project)?.w}
              height={coverDimensions(project)?.h}
            />
            <span class="work-spotlight-caption">
              <strong>{project.data.title}</strong>
              <span class="mono">{project.presentation.discipline} · {project.data.year}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <nav class="portfolio-work__project-links" aria-label={copy.projectLinksLabel}>
      {presentation.overview.map((project, index) => (
        <a href={localizePath(`/work/${project.id}`, locale)} data-overview-project={project.id}>
          {project.media.cover && (
            <span class="portfolio-work__card-image" aria-hidden="true" style={`--card-drift-delay: ${index * -2.5}s`}>
              <img
                src={project.media.cover}
                alt=""
                loading="lazy"
                decoding="async"
                width={coverDimensions(project)?.w}
                height={coverDimensions(project)?.h}
              />
            </span>
          )}
          <span class="mono">{project.presentation.discipline}</span>
          <strong>{project.data.title}</strong>
        </a>
      ))}
    </nav>
  </header>)}

  {!isOverview && (<>
  <section class="portfolio-work__selected" aria-labelledby="selected-work-title">
    <div class="portfolio-work__runway">
      <span class="eyebrow">{copy.selectedEyebrow}</span>
      <span class="portfolio-work__runway-count mono">01—{String(featured.length).padStart(2, '0')}</span>
      <span class="portfolio-work__runway-rule" aria-hidden="true"></span>
    </div>
    <h2 id="selected-work-title">{copy.selectedTitle}</h2>
    <div class="portfolio-work__featured">
      {featured.map((project, index) => (
        <WorkEntry
          project={project}
          tier="featured"
          index={index}
          eager={index === firstFeaturedCoverIndex}
        />
      ))}
    </div>
  </section>

  <section class="portfolio-work__more" aria-labelledby="more-work-title">
    <span class="eyebrow">{copy.moreEyebrow}</span>
    <h2 id="more-work-title">{copy.moreTitle}</h2>
    <div class="portfolio-work__more-grid">
      {more.map((project, index) => (
        <WorkEntry project={project} tier="more" index={index} />
      ))}
    </div>
  </section>
  </>)}

</section>

<script>
  import { createSpotlightController } from '../../scripts/spotlight-controller.mjs';

  const spotlightCleanups = new Set<() => void>();

  function initProjectSpotlights() {
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((root) => {
      if (root.dataset.spotlightReady === '1') return;

      const slides = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-spotlight-slide]'));
      if (slides.length === 0) return;

      root.dataset.spotlightReady = '1';
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const loadCurrentImage = (index: number) => {
        const image = slides[index]?.querySelector<HTMLImageElement>('img[data-src]');
        const src = image?.dataset.src;
        if (image && src && !image.getAttribute('src')) image.src = src;
      };
      const prewarmNextImage = (index: number) => {
        const src = slides[(index + 1) % slides.length]
          ?.querySelector<HTMLImageElement>('img[data-src]')?.dataset.src;
        if (!src) return;
        const prewarm = new Image();
        prewarm.src = src;
      };
      const controller = createSpotlightController({
        count: slides.length,
        reducedMotion: motionQuery.matches,
        schedule: (advance) => window.setTimeout(advance, 6000),
        cancel: (timer) => window.clearTimeout(timer),
        setActive: (activeIndex) => {
          slides.forEach((slide, index) => {
            const active = index === activeIndex;
            slide.classList.toggle('is-active', active);
            slide.setAttribute('aria-hidden', String(!active));
            slide.tabIndex = active ? 0 : -1;
            if (active) slide.removeAttribute('inert');
            else slide.setAttribute('inert', '');
          });
          loadCurrentImage(activeIndex);
          prewarmNextImage(activeIndex);
        },
      });
      const pauseForPointer = () => controller.pause('pointer');
      const resumeForPointer = () => controller.resume('pointer');
      const pauseForFocus = () => controller.pause('focus');
      const resumeAfterFocus = () => queueMicrotask(() => {
        if (!root.matches(':focus-within')) controller.resume('focus');
      });
      const syncVisibility = () => {
        if (document.hidden) controller.pause('hidden');
        else controller.resume('hidden');
      };
      const syncReducedMotion = (event: MediaQueryListEvent) => {
        controller.setPaused('reduced-motion', event.matches);
      };

      root.addEventListener('pointerenter', pauseForPointer);
      root.addEventListener('pointerleave', resumeForPointer);
      root.addEventListener('focusin', pauseForFocus);
      root.addEventListener('focusout', resumeAfterFocus);
      document.addEventListener('visibilitychange', syncVisibility);
      motionQuery.addEventListener('change', syncReducedMotion);
      syncVisibility();

      const cleanup = () => {
        controller.dispose();
        root.removeEventListener('pointerenter', pauseForPointer);
        root.removeEventListener('pointerleave', resumeForPointer);
        root.removeEventListener('focusin', pauseForFocus);
        root.removeEventListener('focusout', resumeAfterFocus);
        document.removeEventListener('visibilitychange', syncVisibility);
        motionQuery.removeEventListener('change', syncReducedMotion);
        spotlightCleanups.delete(cleanup);
      };
      spotlightCleanups.add(cleanup);
    });
  }

  document.addEventListener('astro:before-swap', () => {
    [...spotlightCleanups].forEach((cleanup) => cleanup());
  });

  initProjectSpotlights();
  document.addEventListener('astro:page-load', initProjectSpotlights);

  function attachWorkTitleReveal() {
    document.querySelectorAll<HTMLElement>('[data-work-title-reveal]').forEach((title) => {
      if (title.dataset.workRevealReady === '1') return;
      title.dataset.workRevealReady = '1';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      title.classList.add('is-pending');

      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        title.classList.add('is-visible');
        observer.disconnect();
      }, { threshold: 0.35 });
      observer.observe(title);
    });
  }

  attachWorkTitleReveal();
  document.addEventListener('astro:page-load', attachWorkTitleReveal);
</script>

<style>
  .portfolio-work {
    position: relative;
    z-index: 2;
    isolation: isolate;
    background: transparent;
    padding-top: var(--s-7);
    padding-bottom: var(--s-10);
  }

  .portfolio-work__header {
    position: relative;
    isolation: isolate;
    overflow: visible;
    margin-bottom: var(--s-5);
    padding: var(--s-5) 0;
  }

  .portfolio-work__hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.72fr);
    align-items: center;
    gap: clamp(36px, 6vw, 96px);
  }

  .portfolio-work__selected,
  .portfolio-work__more {
    position: relative;
    z-index: 1;
  }

  .portfolio-work__hero-copy {
    min-width: 0;
  }

  .portfolio-work__header h2 {
    margin-top: var(--s-3);
  }

  .portfolio-work__title-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .portfolio-work__title-line > span { display: block; }

  .portfolio-work__title.is-pending .portfolio-work__title-line > span {
    opacity: 0;
    transform: translate3d(-0.55em, 108%, 0) skewY(2deg);
  }

  .portfolio-work__title.is-pending.is-visible .portfolio-work__title-line > span {
    animation: work-line-in 760ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .portfolio-work__title.is-pending.is-visible .portfolio-work__title-line:nth-child(2) > span {
    animation-delay: 110ms;
  }

  .portfolio-work__title.is-pending.is-visible .portfolio-work__title-line:nth-child(3) > span {
    animation-delay: 220ms;
  }

  @keyframes work-line-in {
    to { opacity: 1; transform: none; }
  }

  .portfolio-work__header p {
    margin-top: var(--s-4);
    font-size: var(--t-body);
    max-width: 62ch;
  }

  .portfolio-work__practice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
    list-style: none;
  }

  .portfolio-work__practice a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--muted-graphite);
    border-radius: 2px;
    color: var(--fg-bone);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
  }

  .portfolio-work__project-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .portfolio-work__project-links a {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-2);
    min-width: 0;
    min-height: 116px;
    padding: var(--s-4);
    border: 1px solid rgba(234, 230, 222, 0.3);
    background: var(--bg-noir);
    color: var(--fg-bone);
    overflow-wrap: anywhere;
    overflow: hidden;
    transition: border-color 300ms var(--ease-out);
  }

  .portfolio-work__card-image {
    position: absolute;
    inset: -20px;
    z-index: -2;
    pointer-events: none;
    opacity: 0.8;
    transition: opacity 500ms var(--ease-out);
  }

  .portfolio-work__card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(10px) saturate(1.35);
    transform: scale(1.12);
    animation: project-card-drift 18s ease-in-out infinite alternate;
    animation-delay: var(--card-drift-delay, 0s);
  }

  .portfolio-work__project-links a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(110deg, rgba(11, 11, 12, 0.78), rgba(11, 11, 12, 0.58));
  }

  .portfolio-work__project-links a:hover .portfolio-work__card-image,
  .portfolio-work__project-links a:focus-visible .portfolio-work__card-image {
    opacity: 1;
  }

  @keyframes project-card-drift {
    from { transform: translate3d(-4px, 2px, 0) scale(1.12); }
    to { transform: translate3d(4px, -2px, 0) scale(1.18); }
  }

  .portfolio-work__project-links .mono {
    font-size: var(--t-eyebrow);
    color: var(--accent-amber);
    text-transform: uppercase;
  }

  .portfolio-work__project-links strong {
    font-size: var(--t-body-sm);
    line-height: 1.3;
    font-weight: 500;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .portfolio-work__project-links a:hover,
  .portfolio-work__practice a:hover { border-color: var(--accent-amber); }

  .portfolio-work__project-links a:focus-visible,
  .portfolio-work__practice a:focus-visible,
  .work-spotlight-cell:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: 4px;
  }

  .portfolio-work__spotlight {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 3 / 4;
    justify-self: end;
    overflow: hidden;
    border: 1px solid rgba(124, 124, 126, 0.42);
    background: var(--bg-noir);
  }

  .work-spotlight-cell {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 420ms;
    will-change: opacity;
  }

  .work-spotlight-cell.is-active,
  .work-spotlight-cell[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .work-spotlight-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .work-spotlight-caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6) var(--s-4) var(--s-4);
    background: linear-gradient(to top, rgba(11, 11, 12, 0.9), transparent);
  }

  .work-spotlight-caption strong {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1;
  }

  .work-spotlight-caption .mono {
    color: var(--muted-graphite);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
  }

  .work-spotlight-cell:hover .work-spotlight-caption .mono,
  .work-spotlight-cell:focus-visible .work-spotlight-caption .mono {
    color: var(--accent-amber);
  }

  .portfolio-work__selected,
  .portfolio-work__more {
    padding-top: var(--s-10);
  }

  .portfolio-work__selected { padding-top: var(--s-3); }

  .portfolio-work__runway {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: var(--s-4);
  }

  .portfolio-work__runway-count {
    color: var(--muted-graphite);
  }

  .portfolio-work__runway-rule {
    height: 1px;
    background: var(--muted-graphite);
  }

  .portfolio-work__selected > h2,
  .portfolio-work__more > h2 {
    margin-top: var(--s-2);
    margin-bottom: var(--s-5);
  }

  .portfolio-work__featured {
    display: grid;
    gap: var(--s-4);
  }

  .portfolio-work__more-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-8) var(--s-5);
  }

  @media (max-width: 980px) {
    .portfolio-work__project-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .portfolio-work__hero { grid-template-columns: 1fr; }
    .portfolio-work__spotlight {
      width: min(100%, 560px);
      aspect-ratio: 4 / 3;
      justify-self: start;
    }
    .portfolio-work__more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 700px) {
    .portfolio-work__more-grid { grid-template-columns: 1fr; }
    .portfolio-work__runway { grid-template-columns: auto auto; }
    .portfolio-work__runway-rule { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-work__title-line > span { opacity: 1; transform: none; animation: none; }
    .work-spotlight-cell { transition: none; }
    .portfolio-work__card-image img { animation: none; }
    .portfolio-work__card-image,
    .portfolio-work__project-links a { transition: none; }
  }
</style>
