---
import GaussianBackground from '../GaussianBackground.astro';
import { localeFromPath, localizePath } from '../../i18n/locales.mjs';

const locale = localeFromPath(Astro.url);

// GitHub data is hardcoded from the real public API
// (https://api.github.com/users/ntworm). Update manually when profile
// changes. The avatar URL is stable and CDN-served by GitHub.
const GH = {
  login: 'ntworm',
  name: 'Gabriel Worm',
  bio: {
    en: 'Sound director working between cinema, music, and code. Building creative tools for performance and Ableton Live.',
    pt: 'Diretor de som entre o cinema, a música e o código. Desenvolvo ferramentas criativas para performance e para o Ableton Live.',
  },
  avatar: 'https://avatars.githubusercontent.com/u/103321841?v=4',
  url: 'https://github.com/ntworm',
};

const GH_REPOS = [
  {
    name: 'rc-surface',
    url: 'https://github.com/ntworm/rc-surface',
    desc: {
      en: 'Turn any phone browser into a wireless MIDI + multi-sensor controller for Ableton Live. 12 performance pads, two XY pads (one with physics), knobs & faders, sensor mappings (motion, orientation, audio, vision), in-browser mapping editor. No phone install. Source-available under the PolyForm Noncommercial 1.0.0 license, built on the Ableton Extensions SDK.',
      pt: 'Transforma o navegador de qualquer celular em um controlador MIDI sem fio, com múltiplos sensores, para o Ableton Live. 12 pads de performance, dois pads XY (um deles com física), knobs e faders, mapeamento de sensores (movimento, orientação, áudio, visão) e editor de mapeamento no próprio navegador. Nada para instalar no celular. Código-fonte disponível sob a licença PolyForm Noncommercial 1.0.0, construído sobre o Ableton Extensions SDK.',
    },
  },
  {
    name: 'rc-setlist',
    url: 'https://github.com/ntworm/rc-setlist',
    desc: {
      en: 'Source-available Ableton Live extension built on the Ableton Extensions SDK that turns Arrangement locators into an operator setlist with synchronized lyrics, tempo and click feedback, and guarded transport controls. Local-first via WebSocket on port 4444. No account, no cloud, no telemetry.',
      pt: 'Extensão para Ableton Live com código-fonte disponível, construída sobre o Ableton Extensions SDK, que transforma os locators do Arrangement em um setlist para o operador, com letras sincronizadas, indicação de andamento e click e controles de transporte com trava de segurança. Roda na rede local, via WebSocket na porta 4444. Sem conta, sem nuvem, sem telemetria.',
    },
  },
  {
    name: 'ableton-mcp-server',
    url: 'https://github.com/ntworm/ableton-mcp-server',
    desc: {
      en: 'Open Model Context Protocol (MCP) server for Ableton Live 12. 97 tools in v0.7.0 over TCP and WebSockets for AI agents (Claude, Antigravity, Gemini, Codex) and audio developers to query parameters, drive transport, automate clips, analyze mix audio in non-realtime, and run grouped batch commands.',
      pt: 'Servidor aberto de Model Context Protocol (MCP) para o Ableton Live 12. São 97 ferramentas na v0.7.0, via TCP e WebSockets, para que agentes de IA (Claude, Antigravity, Gemini, Codex) e desenvolvedores de áudio consultem parâmetros, controlem o transporte, automatizem clips, analisem o áudio da mixagem fora do tempo real e executem comandos em lote agrupados.',
    },
  },
  {
    name: 'Fxhash_Template_HYDRA_with_P5',
    url: 'https://github.com/ntworm/Fxhash_Template_HYDRA_with_P5',
    desc: {
      en: 'FXHASH boilerplate (2022) for combining Hydra.js + p5.js in one fxhash-compatible sketch. Personal — paused.',
      pt: 'Boilerplate para FXHASH (2022) que combina Hydra.js + p5.js em um único sketch compatível com o fxhash. Projeto pessoal — em pausa.',
    },
  },
];

const TOOLS = [
  {
    slug: 'rc-surface',
    title: 'RC Surface',
    year: '2026',
    role: { en: 'Author', pt: 'Autor' },
    desc: {
      en: 'Extension for Ableton Live built with the Ableton Extensions SDK (.ablx). Phone browser becomes a wireless MIDI + multi-sensor controller: 12 performance pads, two XY pads (one with physics), knobs & faders, sensor mappings (motion, orientation, audio, vision), in-browser mapping editor. Source-available under the PolyForm Noncommercial 1.0.0 license.',
      pt: 'Extensão para Ableton Live feita com o Ableton Extensions SDK (.ablx). O navegador do celular vira um controlador MIDI sem fio com múltiplos sensores: 12 pads de performance, dois pads XY (um deles com física), knobs e faders, mapeamento de sensores (movimento, orientação, áudio, visão) e editor de mapeamento no navegador. Código-fonte disponível sob a licença PolyForm Noncommercial 1.0.0.',
    },
    img: '/work/rc-surface/1.jpg',
    href: 'https://github.com/ntworm/rc-surface',
  },
  {
    slug: 'rc-setlist',
    title: 'RC Setlist',
    year: '2026',
    role: { en: 'Author', pt: 'Autor' },
    desc: {
      en: 'Ableton Live extension built on the Ableton Extensions SDK that turns Arrangement locators into an operator setlist. Synchronized .lrc lyrics, tempo and click feedback, guarded transport, /setlist and /performance views served over WebSocket. Source-available under the PolyForm Noncommercial 1.0.0 license.',
      pt: 'Extensão para Ableton Live construída sobre o Ableton Extensions SDK que transforma os locators do Arrangement em um setlist para o operador. Letras .lrc sincronizadas, indicação de andamento e click, transporte com trava de segurança e as telas /setlist e /performance servidas via WebSocket. Código-fonte disponível sob a licença PolyForm Noncommercial 1.0.0.',
    },
    img: '/work/rc-setlist/1.jpg',
    href: 'https://github.com/ntworm/rc-setlist',
  },
  {
    slug: 'ableton-mcp-server',
    title: 'Ableton MCP Server',
    year: '2026',
    role: { en: 'Author', pt: 'Autor' },
    desc: {
      en: 'Model Context Protocol server for Ableton Live 12 bridging the Ableton Extensions SDK and MIDI Remote Scripts. Exposes 97 tools in v0.7.0 over TCP and WebSockets for AI agents and Python scripts to query parameters, drive transport, automate clips, analyze mix audio in non-realtime, and run grouped batch commands. Open-source.',
      pt: 'Servidor de Model Context Protocol para o Ableton Live 12 que faz a ponte entre o Ableton Extensions SDK e os MIDI Remote Scripts. Expõe 97 ferramentas na v0.7.0, via TCP e WebSockets, para que agentes de IA e scripts em Python consultem parâmetros, controlem o transporte, automatizem clips, analisem o áudio da mixagem fora do tempo real e executem comandos em lote agrupados. Código aberto.',
    },
    img: '/work/ableton-mcp-server/1.jpg',
    href: 'https://github.com/ntworm/ableton-mcp-server',
  },
  {
    slug: 'lucy',
    title: 'LUCY',
    year: '2021',
    role: { en: 'Creator', pt: 'Criador' },
    desc: {
      en: 'Generative audiovisual automaton. Max + Ableton + Hydra.js. Probabilistic MIDI control with scale maps, real-time section transitions, frequency-mask-aware final mix. Published on Teia as the `lucy` collection.',
      pt: 'Autômato audiovisual generativo. Max + Ableton + Hydra.js. Controle MIDI probabilístico com mapas de escala, transições de seção em tempo real e uma mixagem final atenta ao mascaramento de frequências. Publicado na Teia como a coleção `lucy`.',
    },
    img: '/work/lucy/1.webp',
    href: '/work/lucy',
  },
  {
    slug: 'eletronik-fields',
    title: 'Eletronik Fields',
    year: '2023',
    role: { en: 'Creator', pt: 'Criador' },
    desc: {
      en: 'An instrument for listening to the invisible electromagnetic layer of the city. A magnetic induction coil captures the fields; Max reads them through FFT and writes MIDI for Ableton Live, while Hydra.js turns the same signal into image. Shown as a dark-room installation where visitors explore the fields with the coil in their own hands.',
      pt: 'Um instrumento para escutar a camada eletromagnética invisível da cidade. Uma bobina de indução magnética capta os campos; o Max os lê por FFT e escreve MIDI para o Ableton Live, enquanto o Hydra.js transforma o mesmo sinal em imagem. Apresentado como instalação em sala escura, onde o público explora os campos com a bobina nas próprias mãos.',
    },
    img: '/work/eletronik-fields/1.webp',
    href: '/work/eletronik-fields',
  },
  {
    slug: 'kakofoni-orquestra',
    title: 'Kakofoni Orquestra',
    year: '2022',
    role: { en: 'Collaborator + Programmer', pt: 'Colaborador + programador' },
    desc: {
      en: 'Generative audiovisual on fxhash. Hydra.js visuals by Rangga Purnama Aji, audio and reactivity by me. Inspired by Brian Eno\'s Ambient 1: Music for Airports. Edition #37 acquired by the Madison Museum.',
      pt: 'Audiovisual generativo no fxhash. Visuais em Hydra.js de Rangga Purnama Aji; áudio e reatividade feitos por mim. Inspirado em Ambient 1: Music for Airports, de Brian Eno. A edição #37 foi adquirida pelo Madison Museum.',
    },
    img: '/work/kakofoni-orquestra/1.jpg',
    href: '/work/kakofoni-orquestra',
  },
];
const tools = TOOLS.map((tool) => ({
  ...tool,
  role: tool.role[locale],
  desc: tool.desc[locale],
  href: localizePath(tool.href, locale),
}));
const repos = GH_REPOS.map((repo) => ({ ...repo, desc: repo.desc[locale] }));

const copy = {
  en: {
    eyebrow: 'Code',
    profileLabel: 'GitHub profile',
    viewOnGitHub: (login: string) => `View ${login} on GitHub`,
    avatarAlt: (name: string) => `${name} GitHub avatar`,
    reposLabel: 'Public repositories',
    profileCta: 'View full profile on GitHub →',
    toolsHeading: 'Tools & instruments',
    toolsLabel: 'Tools and instruments',
    imagePending: 'image pending',
    lowerLabel: 'Generative and Gaussian projects',
    fxhashLabel: 'Generative pieces on fxhash',
    fxhashHeading: 'Generative pieces',
    fxhashCta: 'Browse all on fxhash ↗',
    splatsLabel: 'Gaussian Splatting captures',
    splatsEyebrow: '2026 · in progress',
  },
  pt: {
    eyebrow: 'Código',
    profileLabel: 'Perfil no GitHub',
    viewOnGitHub: (login: string) => `Ver ${login} no GitHub`,
    avatarAlt: (name: string) => `Avatar de ${name} no GitHub`,
    reposLabel: 'Repositórios públicos',
    profileCta: 'Ver o perfil completo no GitHub →',
    toolsHeading: 'Ferramentas e instrumentos',
    toolsLabel: 'Ferramentas e instrumentos',
    imagePending: 'imagem em breve',
    lowerLabel: 'Projetos generativos e em Gaussian Splatting',
    fxhashLabel: 'Peças generativas no fxhash',
    fxhashHeading: 'Peças generativas',
    fxhashCta: 'Ver todas no fxhash ↗',
    splatsLabel: 'Capturas em Gaussian Splatting',
    splatsEyebrow: '2026 · em andamento',
  },
}[locale];

// fxhash profile shows "Created (30)" as the count for nt_worm.
// We don't name individual piece titles here — those need to come from
// the user; previous inventions ("LIQUID", "Ó–Ó") have been removed.
const FXHASH = {
  count: 30,
  handle: 'nt_worm',
  url: 'https://killedbyapixel.github.io/fxhashArchive/#/artist/tz1du7JyqkpAWrQf7kspXS383wpMxkVWCoqQ',
};

// Gaussian Splatting captures surfaced as a card at the bottom of /code/.
// On the page background (GaussianBackground.astro) the splats also stream
// at random as a 3D scene. Here we expose them as a static catalog.
const SPLATS = [
  { src: '/work/code/splats/luzoebreno/luzoebreno.splat', preview: '/work/code/splats/luzoebreno/luzoebreno.preview.splat', poster: '/work/code/luzoebreno-poster.jpg', label: 'Luzoebreno', size: '71 MB', capture: '1001 cameras · 360° photogrammetry' },
  { src: '/work/code/splats/carro/carro.splat',          preview: '/work/code/splats/carro/carro.preview.splat',          poster: '/work/code/carro-poster.jpg',        label: 'Carro',     size: '85 MB', capture: 'Static photogrammetry capture' },
];
---
<div class="code-chapter" id="code" data-portfolio-chapter="code">
  <header class="code__hero">
    <GaussianBackground splats={[SPLATS[0]]} contained={true} placement="hero-right" cameraMotion={true} particleEffects={true} />
    <div class="wrap code__hero-inner">
      <div class="code__hero-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        {locale === 'pt' ? (
        <h2
          class="code__title"
          data-reveal="typewriter"
          aria-label="Ferramentas e instrumentos para música e performance audiovisual."
        >
          <span class="reveal-seg">Ferramentas </span>
          <span class="reveal-seg">e </span>
          <span class="reveal-seg">instrumentos </span>
          <span class="reveal-seg">para </span>
          <span class="reveal-seg">música </span>
          <span class="reveal-seg">e </span>
          <span class="reveal-seg reveal-amber">performance </span>
          <span class="reveal-seg">audiovisual.</span>
          <span class="reveal-caret" aria-hidden="true">_</span>
        </h2>
        ) : (
        <h2
          class="code__title"
          data-reveal="typewriter"
          aria-label="Tools and instruments for music and audiovisual performance."
        >
          <span class="reveal-seg">Tools </span>
          <span class="reveal-seg">and </span>
          <span class="reveal-seg">instruments </span>
          <span class="reveal-seg">for </span>
          <span class="reveal-seg">music </span>
          <span class="reveal-seg">and </span>
          <span class="reveal-seg">audiovisual </span>
          <span class="reveal-seg reveal-amber">performance.</span>
          <span class="reveal-caret" aria-hidden="true">_</span>
        </h2>
        )}
        {locale === 'pt' ? (
        <p class="code__intro">
          Projetos pessoais, de código aberto e com código-fonte disponível, que passam por devices para
          Max4Live, sistemas audiovisuais generativos e instrumentos para tocar ao vivo. Um dos focos
          centrais é abrir caminho com ferramentas nativas no <strong>Ableton Extensions SDK</strong> oficial
          (runtime Node.js do Live 12.4+), ampliando o que uma DAW pode fazer no palco e na integração com
          agentes de IA. Quase tudo o que está aqui roda em tempo real, em algum palco ou estúdio por aí.
        </p>
        ) : (
        <p class="code__intro">
          Personal, open-source, and source-available projects spanning Max4Live devices, generative
          audiovisual systems, and live instruments. A core focus is pioneering native tools on the
          official <strong>Ableton Extensions SDK</strong> (Live 12.4+ Node.js runtime), expanding DAW capabilities
          for stage performance and AI agent integration. Most of what's here runs in
          real time on a stage or in a studio somewhere.
        </p>
        )}
      </div>
    </div>
  </header>

  <article class="code wrap" data-section="code">

    <section class="gh-card" aria-label={copy.profileLabel}>
      <a href={GH.url} class="gh-card__avatar" rel="noopener" aria-label={copy.viewOnGitHub(GH.login)}>
        <img src={GH.avatar} alt={copy.avatarAlt(GH.name)} loading="lazy" width="96" height="96" />
      </a>
      <div class="gh-card__body">
        <div class="gh-card__head">
          <h2 class="gh-card__name">{GH.name}</h2>
          <a href={GH.url} class="gh-card__handle mono" rel="noopener">@{GH.login}</a>
        </div>
        <p class="gh-card__bio">{GH.bio[locale]}</p>
        <ul class="gh-card__repos" aria-label={copy.reposLabel}>
          {repos.map((r) => (
            <li class="gh-card__repo">
              <a href={r.url} class="gh-card__repo-name" rel="noopener">
                <span>{r.name}</span>
              </a>
              <p class="gh-card__repo-desc">{r.desc}</p>
            </li>
          ))}
        </ul>
        <a href={GH.url} class="gh-card__cta" rel="noopener">{copy.profileCta}</a>
      </div>
    </section>

    <section class="tools" aria-label={copy.toolsLabel}>
      <h2 class="tools__heading">{copy.toolsHeading}</h2>
      <div class="tools__grid">
        {tools.map((t) => (
          <article class="tool-card">
            <div class="tool-card__media" aria-hidden="true">
              {t.img ? (
                <img src={t.img} alt="" loading="lazy" width="800" height="450" />
              ) : (
                <div class="tool-card__placeholder">
                  <span class="mono">{copy.imagePending}</span>
                </div>
              )}
            </div>
            <div class="tool-card__body">
              <span class="tool-card__year mono">{t.year}</span>
              <h3 class="tool-card__name">
                {t.href ? (
                  <a href={t.href} rel="noopener">{t.title} <span aria-hidden="true">↗</span></a>
                ) : (
                  t.title
                )}
              </h3>
              <span class="tool-card__role mono">{t.role}</span>
              <p class="tool-card__desc">{t.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="code__lower-showcase" aria-label={copy.lowerLabel}>
      <GaussianBackground splats={[SPLATS[1]]} contained={true} placement="section-left" cameraMotion={true} particleEffects={true} />
      <div class="code__lower-copy">
        <section class="fxhash" aria-label={copy.fxhashLabel}>
          <h2 class="fxhash__heading">{copy.fxhashHeading}</h2>
          {locale === 'pt' ? (
          <p class="fxhash__intro">
            <strong>{FXHASH.count} tokens generativos</strong> publicados no fxhash como
            <span class="mono">{FXHASH.handle}</span>, entre 2021 e 2026. Hydra.js no visual,
            Web Audio API + OSC na reatividade sonora. Entre os destaques está Kakofoni
            Orquestra (edição #37, adquirida pelo Madison Museum).
          </p>
          ) : (
          <p class="fxhash__intro">
            <strong>{FXHASH.count} generative tokens</strong> published on fxhash as
            <span class="mono">{FXHASH.handle}</span>, between 2021 and 2026. Hydra.js
            for visuals, Web Audio API + OSC for sound reactivity. Highlights include
            Kakofoni Orquestra (edition #37, acquired by the Madison Museum).
          </p>
          )}
          <a href={FXHASH.url} class="fxhash__cta mono" rel="noopener">{copy.fxhashCta}</a>
        </section>

        <section class="splats-card" aria-label={copy.splatsLabel}>
          <span class="eyebrow">{copy.splatsEyebrow}</span>
          <h2 class="splats-card__heading">Gaussian Splatting</h2>
          {locale === 'pt' ? (
          <p class="splats-card__intro">
            Capturas de fotogrametria 3D renderizadas no navegador. O pipeline passa pelo
            Gaussian Splatting TOP do TouchDesigner e chega aqui como um <code>.splat</code> leve
            para a web, depois de comprimido no
            <a href="https://playcanvas.com/supersplat/" rel="noopener" target="_blank">PlayCanvas SuperSplat</a>.
            A segunda captura roda ao lado desta seção como uma cena WebGL ao vivo.
          </p>
          ) : (
          <p class="splats-card__intro">
            3D photogrammetry captures rendered in the browser. The pipeline runs
            through TouchDesigner's Gaussian Splatting TOP and lands here as a
            web-friendly <code>.splat</code> after compression in
            <a href="https://playcanvas.com/supersplat/" rel="noopener" target="_blank">PlayCanvas SuperSplat</a>.
            The second capture streams beside this section as a live WebGL scene.
          </p>
          )}
        </section>
      </div>
    </section>
  </article>
</div>

<style>
  .code-chapter {
    position: relative;
    overflow-x: clip;
  }

  .code { padding-top: 0; padding-bottom: var(--s-10); position: relative; z-index: 1; }
  /* The copy follows the About page's left edge. The Gaussian remains a
     full-bleed background layer, but its sharp focal area sits on the right. */
  .code__hero {
    position: relative;
    min-height: clamp(640px, 85vh, 860px);
    width: 100%;
    margin-bottom: var(--s-8);
    padding: var(--s-7) 0;
    display: flex;
    align-items: center;
    background: transparent;
    overflow: visible;
  }
  .code__hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }
  .code__hero-copy {
    width: min(46vw, 620px);
  }
  .code__title {
    font-size: clamp(48px, 7vw, 92px);
    margin-top: var(--s-3);
  }
  .code__intro {
    margin-top: var(--s-5);
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--fg-bone);
    max-width: 44ch;
  }

  @media (max-width: 880px) {
    .code__hero { min-height: 660px; }
    .code__hero-copy { width: min(58vw, 520px); }
    .code__title { font-size: clamp(48px, 8vw, 70px); }
  }

  @media (max-width: 720px) {
    .code__hero {
      min-height: 620px;
      padding: var(--s-8) 0;
    }
    .code__hero-copy { width: 100%; max-width: 560px; }
    .code__intro { max-width: 38ch; }
  }

  /* GitHub profile card */
  .gh-card,
  .tools {
    position: relative;
    z-index: 2;
  }

  /* The Gaussian remains visible as atmosphere through these surfaces, but
     the content itself always paints above it. Backdrop filtering affects
     only the pixels behind each card, never its text or media. */
  .gh-card,
  .tool-card {
    background: rgba(11, 11, 12, 0.64);
    backdrop-filter: blur(18px) brightness(0.72) saturate(0.75);
    -webkit-backdrop-filter: blur(18px) brightness(0.72) saturate(0.75);
  }

  .gh-card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--s-5);
    padding: var(--s-5);
    margin-bottom: var(--s-9);
    border: 1px solid var(--muted-graphite);
  }
  .gh-card__avatar {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 2px;
    overflow: hidden;
    border-bottom: 0;
  }
  .gh-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gh-card__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-bottom: var(--s-2);
  }
  .gh-card__name {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.1;
    color: var(--fg-bone);
  }
  .gh-card__handle {
    color: var(--muted-graphite);
    font-size: var(--t-mono);
  }
  .gh-card__handle:hover { color: var(--accent-amber); }
  .gh-card__bio {
    color: var(--fg-bone);
    line-height: 1.5;
    margin-bottom: var(--s-4);
    max-width: 70ch;
  }
  .gh-card__repos {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .gh-card__repo {
    padding: var(--s-3) 0;
    border-top: 1px solid var(--muted-graphite);
  }
  .gh-card__repo-name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--accent-amber);
    border-bottom: 0;
  }
  .gh-card__repo-name:hover { color: var(--fg-bone); }
  .gh-card__repo-desc {
    margin-top: var(--s-1);
    color: var(--fg-bone);
    font-size: var(--t-body-sm);
    line-height: 1.55;
  }
  .gh-card__cta {
    display: inline-block;
    color: var(--accent-amber);
    font-size: var(--t-mono);
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--muted-graphite);
  }
  .gh-card__cta:hover {
    color: var(--fg-bone);
    border-bottom-color: var(--accent-amber);
  }
  @media (max-width: 640px) {
    .gh-card { grid-template-columns: 1fr; }
