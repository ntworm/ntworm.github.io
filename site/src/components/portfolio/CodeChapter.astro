---
import GaussianBackground from '../GaussianBackground.astro';

// GitHub data is hardcoded from the real public API
// (https://api.github.com/users/ntworm). Update manually when profile
// changes. The avatar URL is stable and CDN-served by GitHub.
const GH = {
  login: 'ntworm',
  name: 'Gabriel Worm',
  bio: 'Sound director working between cinema, music, and code. Building creative tools for performance and Ableton Live.',
  avatar: 'https://avatars.githubusercontent.com/u/103321841?v=4',
  url: 'https://github.com/ntworm',
};

const GH_REPOS = [
  {
    name: 'ableton-rc-surface',
    url: 'https://github.com/ntworm/ableton-rc-surface',
    desc: 'Turn any phone browser into a wireless MIDI + multi-sensor controller for Ableton Live. 12 performance pads, two physics XY pads, knobs & faders, sensor mappings (motion, orientation, audio, vision), in-browser mapping editor. No phone install. Source-available under the PolyForm Noncommercial 1.0.0 license, built on the Ableton Extensions SDK.',
  },
  {
    name: 'rc-setlist',
    url: 'https://github.com/ntworm/rc-setlist',
    desc: 'Source-available Ableton Live extension that turns Arrangement locators into an operator setlist with synchronized lyrics, tempo and click feedback, and guarded transport controls. Local-first via WebSocket on port 4444. No account, no cloud, no telemetry.',
  },
  {
    name: 'ableton-mcp-server',
    url: 'https://github.com/ntworm/ableton-mcp-server',
    desc: 'Open Model Context Protocol (MCP) server for Ableton Live 12. 75 tools in v0.5.3 over TCP and WebSockets for AI agents (Claude, Antigravity, Gemini, Codex) and audio developers to query parameters, drive transport, automate clips, analyze mix audio in non-realtime, and run grouped batch commands.',
  },
  {
    name: 'Fxhash_Template_HYDRA_with_P5',
    url: 'https://github.com/ntworm/Fxhash_Template_HYDRA_with_P5',
    desc: 'FXHASH boilerplate (2022) for combining Hydra.js + p5.js in one fxhash-compatible sketch. Personal — paused.',
  },
];

const tools = [
  {
    slug: 'rc-surface',
    title: 'RC Surface',
    year: '2026',
    role: 'Author',
    desc: 'Extension for Ableton Live. Phone browser becomes a wireless MIDI + multi-sensor controller: 12 performance pads, two physics XY pads, knobs & faders, sensor mappings (motion, orientation, audio, vision), in-browser mapping editor. Source-available under the PolyForm Noncommercial 1.0.0 license.',
    img: '/work/rc-surface/1.jpg',
    href: 'https://github.com/ntworm/ableton-rc-surface',
  },
  {
    slug: 'rc-setlist',
    title: 'RC Setlist',
    year: '2026',
    role: 'Author',
    desc: 'Ableton Live extension that turns Arrangement locators into an operator setlist. Synchronized .lrc lyrics, tempo and click feedback, guarded transport, /setlist and /performance views served over WebSocket. Source-available under the PolyForm Noncommercial 1.0.0 license.',
    img: '/work/rc-setlist/1.jpg',
    href: 'https://github.com/ntworm/rc-setlist',
  },
  {
    slug: 'ableton-mcp-server',
    title: 'Ableton MCP Server',
    year: '2026',
    role: 'Author',
    desc: 'Model Context Protocol server for Ableton Live 12. Exposes 75 tools in v0.5.3 over TCP and WebSockets for AI agents and Python scripts to query parameters, drive transport, automate clips, analyze mix audio in non-realtime, and run grouped batch commands. Open-source.',
    img: '/work/ableton-mcp-server/1.jpg',
    href: 'https://github.com/ntworm/ableton-mcp-server',
  },
  {
    slug: 'lucy',
    title: 'LUCY',
    year: '2021',
    role: 'Creator',
    desc: 'Generative audiovisual automaton. Max + Ableton + Hydra.js. Probabilistic MIDI control with scale maps, real-time section transitions, frequency-mask-aware final mix. Published on Teia as the `lucy` collection.',
    img: '/work/lucy/1.webp',
    href: '/work/lucy',
  },
  {
    slug: 'eletronik-fields',
    title: 'Eletronik Fields',
    year: '2023',
    role: 'Creator',
    desc: 'Audiovisual instrument that converts electromagnetic signals to music via a magnetic induction coil. Max 8 patches for sound-to-MIDI mapping, with real-time oscilloscope visuals projected in a dark room.',
    img: '/work/eletronik-fields/1.webp',
    href: '/work/eletronik-fields',
  },
  {
    slug: 'kakofoni-orquestra',
    title: 'Kakofoni Orquestra',
    year: '2022',
    role: 'Collaborator + Programmer',
    desc: 'Generative audiovisual on fxhash. Hydra.js visuals by Rangga Purnama Aji, audio and reactivity by me. Inspired by Brian Eno\'s Ambient 1: Music for Airports. Edition #37 acquired by the Madison Museum.',
    img: '/work/kakofoni-orquestra/1.jpg',
    href: '/work/kakofoni-orquestra',
  },
];

// fxhash profile shows "Created (30)" as the count for nt_worm.
// We don't name individual piece titles here — those need to come from
// the user; previous inventions ("LIQUID", "Ó–Ó") have been removed.
const FXHASH = {
  count: 30,
  handle: 'nt_worm',
  url: 'https://www.fxhash.xyz/u/nt_worm',
};

// Gaussian Splatting captures surfaced as a card at the bottom of /code/.
// On the page background (GaussianBackground.astro) the splats also stream
// at random as a 3D scene. Here we expose them as a static catalog.
const SPLATS = [
  { src: '/work/code/splats/luzoebreno/luzoebreno.splat', poster: '/work/code/luzoebreno-poster.jpg', label: 'Luzoebreno', size: '71 MB', capture: '1001 cameras · 360° photogrammetry' },
  { src: '/work/code/splats/carro/carro.splat',          poster: '/work/code/carro-poster.jpg',        label: 'Carro',     size: '85 MB', capture: 'Static photogrammetry capture' },
];
---
<div class="code-chapter" id="code" data-portfolio-chapter="code">
  <header class="code__hero">
    <GaussianBackground splats={[SPLATS[0]]} contained={true} placement="hero-right" cameraMotion={true} particleEffects={true} />
    <div class="wrap code__hero-inner">
      <div class="code__hero-copy">
        <span class="eyebrow">Code</span>
        <h2
          class="code__title"
          data-reveal="typewriter"
          aria-label="Tools and instruments for music and audiovisual performance."
        >
          <span class="reveal-seg">Tools </span>
          <span class="reveal-seg">and </span>
          <span class="reveal-seg">instruments </span>
          <span class="reveal-seg">for </span>
          <span class="reveal-seg">music </span>
          <span class="reveal-seg">and </span>
          <span class="reveal-seg">audiovisual </span>
          <span class="reveal-seg reveal-amber">performance.</span>
          <span class="reveal-caret" aria-hidden="true">_</span>
        </h2>
        <p class="code__intro">
          Personal, open-source, and source-available projects spanning Max4Live devices, generative
          audiovisual systems, and live instruments. Most of what's here runs in
          real time on a stage or in a studio somewhere.
        </p>
      </div>
    </div>
  </header>

  <article class="code wrap" data-section="code">

    <section class="gh-card" aria-label="GitHub profile">
      <a href={GH.url} class="gh-card__avatar" rel="noopener" aria-label={`View ${GH.login} on GitHub`}>
        <img src={GH.avatar} alt={`${GH.name} GitHub avatar`} loading="lazy" width="96" height="96" />
      </a>
      <div class="gh-card__body">
        <div class="gh-card__head">
          <h2 class="gh-card__name">{GH.name}</h2>
          <a href={GH.url} class="gh-card__handle mono" rel="noopener">@{GH.login}</a>
        </div>
        <p class="gh-card__bio">{GH.bio}</p>
        <ul class="gh-card__repos" aria-label="Public repositories">
          {GH_REPOS.map((r) => (
            <li class="gh-card__repo">
              <a href={r.url} class="gh-card__repo-name" rel="noopener">
                <span>{r.name}</span>
              </a>
              <p class="gh-card__repo-desc">{r.desc}</p>
            </li>
          ))}
        </ul>
        <a href={GH.url} class="gh-card__cta" rel="noopener">View full profile on GitHub →</a>
      </div>
    </section>

    <section class="tools" aria-label="Tools and instruments">
      <h2 class="tools__heading">Tools &amp; instruments</h2>
      <div class="tools__grid">
        {tools.map((t) => (
          <article class="tool-card">
            {!t.href && (
            <a class="tool-card__media" href={t.href || '#'} rel={t.href ? 'noopener' : undefined} aria-label={t.href ? `${t.title} — open project` : t.title}>
              {t.img ? (
                <img src={t.img} alt={`${t.title} — preview`} loading="lazy" width="800" height="450" />
              ) : (
                <div class="tool-card__placeholder" aria-label="Cover image pending">
                  <span class="mono">image pending</span>
                </div>
              )}
            </a>
            )}
            <div class="tool-card__media" aria-hidden="true">
              {t.img ? (
                <img src={t.img} alt="" loading="lazy" width="800" height="450" />
              ) : (
                <div class="tool-card__placeholder">
                  <span class="mono">image pending</span>
                </div>
              )}
            </div>
            <div class="tool-card__body">
              <span class="tool-card__year mono">{t.year}</span>
              <h3 class="tool-card__name">
                {t.href ? (
                  <a href={t.href} rel="noopener">{t.title} <span aria-hidden="true">↗</span></a>
                ) : (
                  t.title
                )}
              </h3>
              <span class="tool-card__role mono">{t.role}</span>
              <p class="tool-card__desc">{t.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="code__lower-showcase" aria-label="Generative and Gaussian projects">
      <GaussianBackground splats={[SPLATS[1]]} contained={true} placement="section-left" cameraMotion={true} particleEffects={true} />
      <div class="code__lower-copy">
        <section class="fxhash" aria-label="Generative pieces on fxhash">
          <h2 class="fxhash__heading">Generative pieces</h2>
          <p class="fxhash__intro">
            <strong>{FXHASH.count} generative tokens</strong> published on fxhash as
            <span class="mono">{FXHASH.handle}</span>, between 2021 and 2026. Hydra.js
            for visuals, Web Audio API + OSC for sound reactivity. Highlights include
            Kakofoni Orquestra (edition #37, acquired by the Madison Museum).
          </p>
          <a href={FXHASH.url} class="fxhash__cta mono" rel="noopener">Browse all on fxhash ↗</a>
        </section>

        <section class="splats-card" aria-label="Gaussian Splatting captures">
          <span class="eyebrow">2026 · in progress</span>
          <h2 class="splats-card__heading">Gaussian Splatting</h2>
          <p class="splats-card__intro">
            3D photogrammetry captures rendered in the browser. The pipeline runs
            through TouchDesigner's Gaussian Splatting TOP and lands here as a
            web-friendly <code>.splat</code> after compression in
            <a href="https://playcanvas.com/supersplat/" rel="noopener" target="_blank">PlayCanvas SuperSplat</a>.
            The second capture streams beside this section as a live WebGL scene.
          </p>
        </section>
      </div>
    </section>
  </article>
</div>

<style>
  .code-chapter {
    position: relative;
    overflow-x: clip;
  }

  .code { padding-top: 0; padding-bottom: var(--s-10); position: relative; z-index: 1; }
  /* The copy follows the About page's left edge. The Gaussian remains a
     full-bleed background layer, but its sharp focal area sits on the right. */
  .code__hero {
    position: relative;
    min-height: clamp(640px, 85vh, 860px);
    width: 100%;
    margin-bottom: var(--s-8);
    padding: var(--s-7) 0;
    display: flex;
    align-items: center;
    background: transparent;
    overflow: visible;
  }
  .code__hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }
  .code__hero-copy {
    width: min(46vw, 620px);
  }
  .code__title {
    font-size: clamp(48px, 7vw, 92px);
    margin-top: var(--s-3);
  }
  .code__intro {
    margin-top: var(--s-5);
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--fg-bone);
    max-width: 44ch;
  }

  @media (max-width: 880px) {
    .code__hero { min-height: 660px; }
    .code__hero-copy { width: min(58vw, 520px); }
    .code__title { font-size: clamp(48px, 8vw, 70px); }
  }

  @media (max-width: 720px) {
    .code__hero {
      min-height: 620px;
      padding: var(--s-8) 0;
    }
    .code__hero-copy { width: 100%; max-width: 560px; }
    .code__intro { max-width: 38ch; }
  }

  /* GitHub profile card */
  .gh-card,
  .tools {
    position: relative;
    z-index: 2;
  }

  /* The Gaussian remains visible as atmosphere through these surfaces, but
     the content itself always paints above it. Backdrop filtering affects
     only the pixels behind each card, never its text or media. */
  .gh-card,
  .tool-card {
    background: rgba(11, 11, 12, 0.64);
    backdrop-filter: blur(18px) brightness(0.72) saturate(0.75);
    -webkit-backdrop-filter: blur(18px) brightness(0.72) saturate(0.75);
  }

  .gh-card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--s-5);
    padding: var(--s-5);
    margin-bottom: var(--s-9);
    border: 1px solid var(--muted-graphite);
  }
  .gh-card__avatar {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 2px;
    overflow: hidden;
    border-bottom: 0;
  }
  .gh-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gh-card__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-bottom: var(--s-2);
  }
  .gh-card__name {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.1;
    color: var(--fg-bone);
  }
  .gh-card__handle {
    color: var(--muted-graphite);
    font-size: var(--t-mono);
  }
  .gh-card__handle:hover { color: var(--accent-amber); }
  .gh-card__bio {
    color: var(--fg-bone);
    line-height: 1.5;
    margin-bottom: var(--s-4);
    max-width: 70ch;
  }
  .gh-card__repos {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .gh-card__repo {
    padding: var(--s-3) 0;
    border-top: 1px solid var(--muted-graphite);
  }
  .gh-card__repo-name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--accent-amber);
    border-bottom: 0;
  }
  .gh-card__repo-name:hover { color: var(--fg-bone); }
  .gh-card__repo-desc {
    margin-top: var(--s-1);
    color: var(--fg-bone);
    font-size: var(--t-body-sm);
    line-height: 1.55;
  }
  .gh-card__cta {
    display: inline-block;
    color: var(--accent-amber);
    font-size: var(--t-mono);
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--muted-graphite);
  }
  .gh-card__cta:hover {
    color: var(--fg-bone);
    border-bottom-color: var(--accent-amber);
  }
  @media (max-width: 640px) {
    .gh-card { grid-template-columns: 1fr; }
    .gh-card__avatar { width: 64px; height: 64px; }
  }

  /* Tools grid */
  .tools { margin-bottom: var(--s-9); }
  .tools__heading {
    font-size: var(--t-h2);
    margin-bottom: var(--s-6);
    color: var(--muted-graphite);
    font-weight: 500;
  }
  .tools__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }
  .tool-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--muted-graphite);
    transition: border-color var(--d-fast) var(--ease-out);
  }
  .tool-card:hover { border-color: var(--accent-amber); }
  .tool-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(11, 11, 12, 0.64);
    border-bottom: 1px solid var(--muted-graphite);
    min-height: 200px;
  }
  .tool-card__media img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 220px;
    display: block;
    object-fit: contain;
  }
  .tool-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-graphite);
  }
  .tool-card__body {
    padding: var(--s-4) var(--s-4) var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .tool-card__year {
    color: var(--muted-graphite);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .tool-card__name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.15;
    margin-top: var(--s-1);
  }
  .tool-card__name a {
    color: var(--fg-bone);
    border-bottom: 0;
  }
  .tool-card__name a:hover { color: var(--accent-amber); }
  .tool-card__role {
    color: var(--muted-graphite);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .tool-card__desc {
    color: var(--fg-bone);
    line-height: 1.55;
    font-size: var(--t-body-sm);
  }
  @media (max-width: 720px) {
    .tools__grid { grid-template-columns: 1fr; }
  }

  /* Lower opening: the second Gaussian and copy invert the hero composition,
     creating an alternating left/right rhythm down the page. */
  .code__lower-showcase {
    position: relative;
    min-height: clamp(680px, 90vh, 900px);
    display: grid;
    grid-template-columns: minmax(0, 56%) minmax(0, 44%);
    align-items: center;
    isolation: isolate;
    overflow: visible;
  }
  .code__lower-copy {
    position: relative;
    z-index: 3;
    grid-column: 2;
    padding: var(--s-8) 0 var(--s-8) var(--s-7);
  }

  .fxhash {
    padding: var(--s-7) 0;
    border-top: 1px solid var(--muted-graphite);
    border-bottom: 1px solid var(--muted-graphite);
  }
  .fxhash__heading {
    font-size: var(--t-h2);
    margin-bottom: var(--s-3);
    color: var(--muted-graphite);
    font-weight: 500;
  }
  .fxhash__intro {
    color: var(--fg-bone);
    line-height: 1.6;
    max-width: 44ch;
    margin-bottom: var(--s-4);
    font-size: var(--t-body-sm);
  }
  .fxhash__intro strong { color: var(--accent-amber); }
  .fxhash__cta {
    color: var(--accent-amber);
    font-size: var(--t-mono);
    letter-spacing: 0.05em;
  }
  .fxhash__cta:hover { color: var(--fg-bone); }

  .splats-card {
    padding: var(--s-7) 0;
    border-bottom: 1px solid var(--muted-graphite);
  }
  .splats-card .eyebrow {
    display: inline-block;
    margin-bottom: var(--s-2);
    color: var(--accent-amber);
  }
  .splats-card__heading {
    font-size: var(--t-h2);
    margin-bottom: var(--s-3);
    color: var(--muted-graphite);
    font-weight: 500;
  }
  .splats-card__intro {
    color: var(--fg-bone);
    line-height: 1.65;
    max-width: 44ch;
    margin-bottom: 0;
    font-size: var(--t-body-sm);
  }
  .splats-card__intro a {
    color: var(--accent-amber);
    border-bottom: 0;
  }
  .splats-card__intro a:hover { color: var(--fg-bone); }
  .splats-card__intro code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: rgba(245, 232, 208, 0.08);
    padding: 0.05em 0.35em;
  }
  @media (max-width: 880px) {
    .code__lower-showcase {
      min-height: 760px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 58vw);
    }
    .code__lower-copy { padding-left: var(--s-5); }
  }

  @media (max-width: 720px) {
    .code__lower-showcase {
      min-height: auto;
      display: block;
      padding: var(--s-8) 0;
    }
    .code__lower-copy { padding: 0; }
  }

  /* Terminal-style typewriter reveal inherited from the former About hero. */
  .code__title { min-height: 1.2em; }
  .reveal-seg {
    display: inline;
  }
  .reveal-seg.reveal-amber { color: var(--accent-amber); }
  .reveal-caret {
    display: inline-block;
    color: var(--accent-amber);
    opacity: 0;
    font-family: var(--font-mono);
  }
  .reveal-caret[data-visible="true"] {
    animation: caret-blink 700ms steps(2, start) infinite;
  }
  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-seg {
      opacity: 1;
    }
    .reveal-caret { display: none; }
  }
</style>
