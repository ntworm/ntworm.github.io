---
/**
 * GaussianBackground — full-viewport 3D Gaussian splat as page background.
 *
 * Picks one of N splats at random per page load. Initializes gsplat.js from
 * CDN on first IntersectionObserver hit. Falls back to a static poster image
 * during load and on mobile (data-saver friendly).
 *
 * Splats are loaded once and orbit continuously. The canvas is `position:fixed`
 * so it stays anchored to the viewport while the user scrolls. A radial mask
 * fades the splat from the page edges inward, so cards/sections stacked above
 * read clearly while the splat breathes behind them.
 *
 * Props:
 *   splats — array of { src, poster, label } pairs (root-relative URLs)
 *   mobileBreakpoint — width below which we skip WebGL and show poster only
 *   placement — optional visual treatment for a specific page composition
 */

interface SplatEntry {
  src: string;
  poster: string;
  label: string;
}

interface Props {
  splats: SplatEntry[];
  mobileBreakpoint?: number;
  /**
   * When true, the background is positioned `absolute` inside its parent
   * (e.g. a hero section) instead of `fixed` across the viewport. Use this
   * when the splat should fade out below the fold rather than bleed through
   * the whole page.
   */
  contained?: boolean;
  placement?: 'full' | 'hero-right' | 'section-right' | 'section-left';
  /** Enables the cinematic scroll/pointer orbit for this instance only. */
  cameraMotion?: boolean;
  /** Enables reversible GPU digital-dust and scanline modulation. */
  particleEffects?: boolean;
}

const {
  splats,
  mobileBreakpoint = 768,
  contained = false,
  placement = 'full',
  cameraMotion = false,
  particleEffects = false,
} = Astro.props;

if (!splats || splats.length === 0) {
  throw new Error('GaussianBackground requires at least one splat entry.');
}
---

<div class="gs-bg" data-mobile-breakpoint={mobileBreakpoint} data-splats={JSON.stringify(splats)} data-contained={contained ? '1' : '0'} data-placement={placement} data-camera-motion={cameraMotion ? '1' : undefined} data-particle-effects={particleEffects ? '1' : undefined}>
  <canvas class="gs-bg__canvas" aria-hidden="true"></canvas>
  <div class="gs-bg__veil" aria-hidden="true"></div>
</div>


<script>
import { createGaussianAutopilot, damp, gaussianFocusPoint, gaussianFocusProximity, gaussianPointerLook, gaussianToggleHotspot, sampleGaussianCamera } from '../scripts/gaussian-camera-motion.mjs';
import { createPausableFrameLoop } from '../scripts/gaussian-frame-loop.mjs';
import { calculateParticleBounds, createGaussianLightAutopilot, createGaussianParticleAutopilot, createGaussianParticleUniformController, createGaussianWorldTransition, gaussianParticleProfile, installGaussianParticleShaderPatch } from '../scripts/gaussian-particle-effects.mjs';

type SplatEntry = { src: string; poster: string; label: string };

interface GaussianRuntimeController {
  setActive(active: boolean): void;
  dispose(): void;
  getState(): {
    active: boolean;
    disposed: boolean;
    activeSeconds: number;
    frameCount: number;
  };
}

declare global {
  interface Window {
    __gsBgStart?: (src: string, stage: HTMLElement) => Promise<GaussianRuntimeController | null>;
    __gsBgLoaded?: boolean;
    __gsBgReady?: Promise<void>;
    __gsBgReadyResolve?: () => void;
    __gsBgLifecycle?: {
      createPausableFrameLoop: typeof createPausableFrameLoop;
    };
    __gsBgMotion?: {
      createGaussianAutopilot: typeof createGaussianAutopilot;
      damp: typeof damp;
      gaussianFocusPoint: typeof gaussianFocusPoint;
      gaussianFocusProximity: typeof gaussianFocusProximity;
      gaussianPointerLook: typeof gaussianPointerLook;
      gaussianToggleHotspot: typeof gaussianToggleHotspot;
      sampleGaussianCamera: typeof sampleGaussianCamera;
    };
    __gsBgParticles?: {
      calculateParticleBounds: typeof calculateParticleBounds;
      createGaussianLightAutopilot: typeof createGaussianLightAutopilot;
      createGaussianParticleAutopilot: typeof createGaussianParticleAutopilot;
      createGaussianParticleUniformController: typeof createGaussianParticleUniformController;
      createGaussianWorldTransition: typeof createGaussianWorldTransition;
      gaussianParticleProfile: typeof gaussianParticleProfile;
      installGaussianParticleShaderPatch: typeof installGaussianParticleShaderPatch;
    };
    __gsBgDebug?: () => Array<{
      placement: string;
      state: string;
      runtime: ReturnType<GaussianRuntimeController['getState']> | null;
    }>;
  }
}

const SPLAT_LIB = 'https://esm.sh/gsplat@1.2.9';
window.__gsBgLifecycle = { createPausableFrameLoop };
window.__gsBgMotion = { createGaussianAutopilot, damp, gaussianFocusPoint, gaussianFocusProximity, gaussianPointerLook, gaussianToggleHotspot, sampleGaussianCamera };
window.__gsBgParticles = { calculateParticleBounds, createGaussianLightAutopilot, createGaussianParticleAutopilot, createGaussianParticleUniformController, createGaussianWorldTransition, gaussianParticleProfile, installGaussianParticleShaderPatch };

async function loadSplatEngine(): Promise<void> {
  if (window.__gsBgStart) return;
  if (window.__gsBgReady) {
    await window.__gsBgReady;
    return;
  }
  const code = [
    "import * as SPLAT from '" + SPLAT_LIB + "';",
    "window.__gsBgStart = async function(src, stage) {",
    "  const scene = new SPLAT.Scene();",
    "  const camera = new SPLAT.Camera();",
    "  const particles = window.__gsBgParticles;",
    "  const lifecycle = window.__gsBgLifecycle;",
    "  if (!lifecycle) throw new Error('[gs-bg] lifecycle unavailable');",
    "  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;",
    "  const hasParticleEffects = stage.dataset.particleEffects === '1' && !reducedMotion && particles;",
    "  let renderer = null;",
    "  let particleShaderActive = false;",
    "  if (hasParticleEffects) {",
    "    const particleShaderHook = particles.installGaussianParticleShaderPatch();",
    "    try {",
    "      renderer = new SPLAT.WebGLRenderer();",
    "      particleShaderActive = particleShaderHook.wasApplied() && renderer.gl.getProgramParameter(renderer.renderProgram.program, renderer.gl.LINK_STATUS);",
    "    } catch (error) {",
    "      console.warn('[gs-bg] particle shader unavailable; using stock renderer', error);",
    "    } finally { particleShaderHook.restore(); }",
    "    if (!renderer || !particleShaderActive) {",
    "      if (renderer) { renderer.dispose(); renderer.canvas.remove(); }",
    "      renderer = new SPLAT.WebGLRenderer();",
    "    }",
    "  } else {",
    "    renderer = new SPLAT.WebGLRenderer();",
    "  }",
    "  renderer.canvas.classList.add('gs-bg__live-canvas');",
    "  renderer.canvas.style.cssText = 'width:100%;height:100%;display:block;position:absolute;inset:0';",
    "  stage.appendChild(renderer.canvas);",
    "  const motion = window.__gsBgMotion;",
    "  const hasCameraMotion = stage.dataset.cameraMotion === '1' && motion;",
    "  const zoomScale = stage.dataset.placement === 'section-left' ? 2.5 : 1.5;",
    "  const autopilotSeed = ((stage.dataset.placement === 'section-left' ? 8117 : 1469) ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;",
    "  const autopilot = hasCameraMotion ? motion.createGaussianAutopilot(autopilotSeed) : null;",
    "  // Force renderer to use the actual size. Contained mode fills the parent",
    "  // (hero); default mode fills the viewport.",
    "  const forceSize = () => {",
    "    let w, h;",
    "    if (stage.dataset.contained === '1') {",
    "      w = stage.clientWidth || window.innerWidth;",
    "      h = stage.clientHeight || window.innerHeight;",
    "    } else {",
    "      w = window.innerWidth;",
    "      h = window.innerHeight;",
    "    }",
    "    renderer.setSize(w, h);",
    "    camera.data && camera.data.setSize(w, h);",
    "  };",
    "  forceSize();",
    "  window.addEventListener('resize', forceSize);",
    "  let angle = 0;",
    "  let radius = 6 / zoomScale;",
    "  let pitch = -0.15;",
    "  let phaseOffset = 0;",
    "  let angularSpeed = 0.108;",
    "  let roll = 0;",
    "  let lookYaw = 0;",
    "  let lookPitch = 0;",
    "  let aimOffsetX = 0;",
    "  let aimOffsetY = 0;",
    "  let verticalOffset = 0;",
    "  let focusProximity = 0;",
    "  let focusTarget = 0;",
    "  let pointerClientX = null;",
    "  let pointerClientY = null;",
    "  const onPointerMove = (event) => {",
    "    pointerClientX = event.clientX;",
    "    pointerClientY = event.clientY;",
    "  };",
    "  const onPointerOut = (event) => {",
    "    if (event.relatedTarget === null) {",
    "      pointerClientX = null;",
    "      pointerClientY = null;",
    "      focusTarget = 0;",
    "    }",
    "  };",
    "  if (hasCameraMotion && !reducedMotion) {",
    "    window.addEventListener('pointermove', onPointerMove, { passive: true });",
    "    window.addEventListener('mouseout', onPointerOut, { passive: true });",
    "  }",
    "  // Set initial camera position",
    "  function setCameraOnOrbit(a, cameraRoll = 0, cameraLookYaw = 0, cameraLookPitch = 0, cameraAimX = 0, cameraAimY = 0) {",
    "    const cx = radius * Math.cos(pitch) * Math.sin(a);",
    "    const cy = radius * Math.sin(pitch);",
    "    const cz = radius * Math.cos(pitch) * Math.cos(a);",
    "    camera.position = new SPLAT.Vector3(cx, cy, cz);",
    "    // Shift the point of interest in the camera's own view plane. This lets",
    "    // the pointer look toward the corners without taking over the orbit.",
    "    const targetDistanceX = cameraAimX * radius;",
    "    const targetDistanceY = cameraAimY * radius;",
    "    const rightX = Math.cos(a), rightZ = -Math.sin(a);",
    "    const upX = -Math.sin(a) * Math.sin(pitch);",
    "    const upY = Math.cos(pitch);",
    "    const upZ = -Math.cos(a) * Math.sin(pitch);",
    "    const targetX = rightX * targetDistanceX + upX * targetDistanceY;",
    "    const targetY = upY * targetDistanceY;",
    "    const targetZ = rightZ * targetDistanceX + upZ * targetDistanceY;",
    "    const fx = targetX - cx, fy = targetY - cy, fz = targetZ - cz;",
    "    const flen = Math.sqrt(fx*fx + fy*fy + fz*fz) || 1;",
    "    const ux = fx/flen, uy = fy/flen, uz = fz/flen;",
    "    // Convert forward vector to euler (yaw + pitch), then to quaternion.",
    "    const yaw = Math.atan2(ux, uz) + cameraLookYaw;",
    "    const pch = Math.asin(Math.max(-0.99, Math.min(0.99, uy))) + cameraLookPitch;",
    "    // gsplat Quaternion has FromEuler(eulerVector3)",
    "    camera.rotation = SPLAT.Quaternion.FromEuler(new SPLAT.Vector3(pch, yaw, cameraRoll));",
    "  }",
    "  setCameraOnOrbit(0, 0, 0, 0);",
    "  try {",
    "    await SPLAT.Loader.LoadAsync(src, scene, () => {});",
    "  } catch (error) {",
    "    window.removeEventListener('resize', forceSize);",
    "    window.removeEventListener('pointermove', onPointerMove);",
    "    window.removeEventListener('mouseout', onPointerOut);",
    "    renderer.dispose();",
    "    renderer.canvas.remove();",
    "    throw error;",
    "  }",
    "  if (!stage.isConnected || stage.dataset.gsDisposed === '1') {",
    "    window.removeEventListener('resize', forceSize);",
    "    window.removeEventListener('pointermove', onPointerMove);",
    "    window.removeEventListener('mouseout', onPointerOut);",
    "    renderer.dispose();",
    "    renderer.canvas.remove();",
    "    return null;",
    "  }",
    "  const splatObject = scene.objects.find((object) => object && object.data && object.data.positions);",
    "  const particleBounds = particleShaderActive ? particles.calculateParticleBounds(splatObject && splatObject.data.positions) : null;",
    "  const particleSeed = ((stage.dataset.placement === 'section-left' ? 4253 : 9719) ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;",
    "  const particleProfile = particles.gaussianParticleProfile(stage.dataset.placement);",
    "  const particleAutopilot = particleShaderActive ? particles.createGaussianParticleAutopilot(particleSeed) : null;",
    "  const lightAutopilot = particleShaderActive ? particles.createGaussianLightAutopilot(particleSeed ^ 0x51f15e, stage.dataset.placement) : null;",
    "  const particleController = particleShaderActive ? particles.createGaussianParticleUniformController(renderer, particleBounds) : null;",
    "  const worldTransition = particleShaderActive ? particles.createGaussianWorldTransition() : null;",
    "  let worldReveal = 0;",
    "  let worldRevealTarget = 0;",
    "  const onWorldToggle = (event) => {",
    "    if (!particleController || !particleController.active || event.button !== 0) return;",
    "    const eventTarget = event.target;",
    "    if (eventTarget instanceof Element && eventTarget.closest('a, button, input, textarea, select, label, [role=button]')) return;",
    "    const host = stage.parentElement || stage;",
    "    const rect = host.getBoundingClientRect();",
    "    if (rect.bottom <= 0 || rect.top >= window.innerHeight) return;",
    "    const focusX = stage.dataset.placement === 'section-left' ? 0.28 : 0.72;",
    "    const focusPoint = motion.gaussianFocusPoint({",
    "      viewportHeight: window.innerHeight, hostTop: rect.top, focusX",
    "    });",
    "    const insideFocus = motion.gaussianToggleHotspot({",
    "      clientX: event.clientX, clientY: event.clientY,",
    "      viewportWidth: window.innerWidth, viewportHeight: window.innerHeight,",
    "      focusX: focusPoint.focusX, focusY: focusPoint.focusY",
    "    });",
    "    if (!insideFocus) return;",
    "    worldRevealTarget = worldRevealTarget > 0.5 ? 0 : 1;",
    "  };",
    "  if (particleController && particleController.active) {",
    "    window.addEventListener('click', onWorldToggle);",
    "  }",
    "  window.__gsBgLoaded = true;",
    "  const renderFrame = ({ deltaSeconds, activeSeconds }) => {",
    "    if (!stage.isConnected || stage.dataset.gsDisposed === '1') {",
    "      controller.dispose();",
    "      return;",
    "    }",
    "    if (hasCameraMotion && !reducedMotion) {",
    "      const host = stage.parentElement || stage;",
    "      const rect = host.getBoundingClientRect();",
    "      const scrollProgress = Math.max(0, Math.min(1, -rect.top / Math.max(1, rect.height)));",
    "      const focusX = stage.dataset.placement === 'section-left' ? 0.28 : 0.72;",
    "      if (pointerClientX !== null && pointerClientY !== null) {",
    "        const focusPoint = motion.gaussianFocusPoint({",
    "          viewportHeight: window.innerHeight, hostTop: rect.top, focusX",
    "        });",
    "        focusTarget = motion.gaussianFocusProximity({",
    "          clientX: pointerClientX, clientY: pointerClientY,",
    "          viewportWidth: window.innerWidth, viewportHeight: window.innerHeight,",
    "          focusX: focusPoint.focusX, focusY: focusPoint.focusY",
    "        });",
    "      } else {",
    "        focusTarget = 0;",
    "      }",
    "      const pointerLookTarget = motion.gaussianPointerLook({",
    "        clientX: pointerClientX ?? window.innerWidth * 0.5,",
    "        clientY: pointerClientY ?? window.innerHeight * 0.5,",
    "        viewportWidth: window.innerWidth, viewportHeight: window.innerHeight",
    "      });",
    "      focusProximity = motion.damp(focusProximity, focusTarget, 5.5, deltaSeconds);",
    "      const sampled = motion.sampleGaussianCamera({",
    "        scrollProgress, focusProximity, zoomScale, timeSeconds: activeSeconds",
    "      });",
    "      const autonomous = autopilot.sample(deltaSeconds);",
    "      aimOffsetX = motion.damp(aimOffsetX, pointerLookTarget.targetX, 1.15, deltaSeconds);",
    "      aimOffsetY = motion.damp(aimOffsetY, pointerLookTarget.targetY, 1.15, deltaSeconds);",
    "      lookYaw = motion.damp(lookYaw, autonomous.lookYaw, 1.35, deltaSeconds);",
    "      lookPitch = motion.damp(lookPitch, autonomous.lookPitch, 1.35, deltaSeconds);",
    "      const radiusResponse = sampled.radius < radius ? 2.4 : 1.25;",
    "      radius = motion.damp(radius, sampled.radius, radiusResponse, deltaSeconds);",
    "      pitch = motion.damp(pitch, sampled.pitch, 2.2, deltaSeconds);",
    "      phaseOffset = motion.damp(phaseOffset, sampled.phaseOffset + autonomous.phaseOffset, 1.7, deltaSeconds);",
    "      angularSpeed = motion.damp(angularSpeed, sampled.angularSpeed * autonomous.speedScale, 1.5, deltaSeconds);",
    "      roll = motion.damp(roll, autonomous.roll, 1.9, deltaSeconds);",
    "      verticalOffset = motion.damp(verticalOffset, sampled.verticalOffset, 1.8, deltaSeconds);",
    "    } else {",
    "      radius = motion ? motion.damp(radius, 6 / zoomScale, 2.6, deltaSeconds) : 6 / zoomScale;",
    "      pitch = motion ? motion.damp(pitch, -0.15, 2.4, deltaSeconds) : -0.15;",
    "      phaseOffset = motion ? motion.damp(phaseOffset, 0, 1.8, deltaSeconds) : 0;",
    "      angularSpeed = motion ? motion.damp(angularSpeed, 0.108, 1.6, deltaSeconds) : 0.108;",
    "      roll = motion ? motion.damp(roll, 0, 1.9, deltaSeconds) : 0;",
    "      lookYaw = motion ? motion.damp(lookYaw, 0, 1.35, deltaSeconds) : 0;",
    "      lookPitch = motion ? motion.damp(lookPitch, 0, 1.35, deltaSeconds) : 0;",
    "      aimOffsetX = motion ? motion.damp(aimOffsetX, 0, 1.15, deltaSeconds) : 0;",
    "      aimOffsetY = motion ? motion.damp(aimOffsetY, 0, 1.15, deltaSeconds) : 0;",
    "      verticalOffset = motion ? motion.damp(verticalOffset, 0, 1.8, deltaSeconds) : 0;",
    "    }",
    "    renderer.canvas.style.setProperty('--gs-scroll-y', verticalOffset + '%');",
    "    angle += angularSpeed * deltaSeconds;",
    "    setCameraOnOrbit(angle + phaseOffset, roll, lookYaw, lookPitch, aimOffsetX, aimOffsetY);",
    "    if (particleController && particleController.active && particleAutopilot && lightAutopilot) {",
    "      const transitionFrame = worldTransition.sample(worldRevealTarget, deltaSeconds);",
    "      worldReveal = transitionFrame.progress;",
    "      const particleFrame = particleAutopilot.sample(deltaSeconds);",
    "      const lightFrame = lightAutopilot.sample(deltaSeconds);",
    "      particleController.update({",
    "        ...particleFrame,",
    "        ...lightFrame,",
    "        coreRadius: 1.5,",
    "        worldReveal: worldReveal,",
    "        transitionActivity: transitionFrame.activity,",
    "        transitionDirection: transitionFrame.direction,",
    "        transitionOpacity: particleProfile.transitionOpacity,",
    "        flowTime: transitionFrame.time,",
    "        nearDistance: Math.max(0.55, radius * 0.67),",
    "        nearStrength: 0.72,",
    "        displacement: particleProfile.displacement",
    "      });",
    "    }",
    "    renderer.render(scene, camera);",
    "  };",
    "  const frameLoop = lifecycle.createPausableFrameLoop({",
    "    onFrame: ({ deltaSeconds, activeSeconds }) => renderFrame({ deltaSeconds, activeSeconds })",
    "  });",
    "  let disposed = false;",
    "  const controller = {",
    "    setActive(active) { frameLoop.setActive(active); },",
    "    dispose() {",
    "      if (disposed) return;",
    "      disposed = true;",
    "      stage.dataset.gsDisposed = '1';",
    "      frameLoop.dispose();",
    "      window.removeEventListener('resize', forceSize);",
    "      window.removeEventListener('pointermove', onPointerMove);",
    "      window.removeEventListener('mouseout', onPointerOut);",
    "      window.removeEventListener('click', onWorldToggle);",
    "      renderer.dispose();",
    "      renderer.canvas.remove();",
    "    },",
    "    getState() { return frameLoop.getState(); }",
    "  };",
    "  return controller;",
    "};",
    "  window.__gsBgReadyResolve && window.__gsBgReadyResolve();",
  ].join('\n');
  const blob = new Blob([code], { type: 'text/javascript' });
  const blobUrl = URL.createObjectURL(blob);
  window.__gsBgReady = new Promise<void>((resolve) => {
    window.__gsBgReadyResolve = resolve;
  });
  const script = document.createElement('script');
  script.type = 'module';
  script.src = blobUrl;
  script.onerror = () => window.__gsBgReadyResolve && window.__gsBgReadyResolve();
  document.head.appendChild(script);
  await window.__gsBgReady;
  URL.revokeObjectURL(blobUrl);
}

function pickRandomSplat(bg: HTMLElement): SplatEntry | null {
  // Splats are passed as prop via data-splats (JSON encoded by Astro template).
  const raw = bg.dataset.splats;
  if (!raw) return null;
  try {
    const list = JSON.parse(raw) as SplatEntry[];
    if (!list.length) return null;
    return list[Math.floor(Math.random() * list.length)];
  } catch (e) {
    console.error('[gs-bg] failed to parse splats list', e);
    return null;
  }
}

async function mountGaussianBackground(
  bg: HTMLElement,
  pick: SplatEntry,
): Promise<GaussianRuntimeController | null> {
  const breakpoint = parseInt(bg.dataset.mobileBreakpoint || '768', 10);
  if (window.innerWidth < breakpoint) return null;
  if (!bg.querySelector<HTMLCanvasElement>('.gs-bg__canvas')) return null;

  await loadSplatEngine();
  if (!bg.isConnected || bg.dataset.gsDisposed === '1') return null;
  if (!pick.src || !window.__gsBgStart) return null;
  return window.__gsBgStart(pick.src, bg);
}

type GaussianMountController = {
  bg: HTMLElement;
  load: () => Promise<void>;
  refreshActivity: () => void;
  dispose: () => void;
  getState: () => {
    placement: string;
    state: string;
    runtime: ReturnType<GaussianRuntimeController['getState']> | null;
  };
};

const gaussianControllers = new Set<GaussianMountController>();

function createGaussianMountController(bg: HTMLElement): GaussianMountController | null {
  const pick = pickRandomSplat(bg);
  if (!pick) return null;

  // Install the selected poster synchronously so observer timing cannot reveal
  // the bare background while the full-quality scene is still outside range.
  if (pick.poster) {
    bg.style.setProperty('--gs-poster', `url(${JSON.stringify(pick.poster)})`);
    bg.classList.add('gs-bg--poster');
  }

  const host = bg.closest('.code__hero, .code__lower-showcase') ?? bg.parentElement ?? bg;
  const breakpoint = parseInt(bg.dataset.mobileBreakpoint || '768', 10);
  let disposed = false;
  let insideActiveZone = false;
  let runtime: GaussianRuntimeController | null = null;
  let loadPromise: Promise<void> | null = null;
  let loadObserver: IntersectionObserver | null = null;
  let activityObserver: IntersectionObserver | null = null;

  const refreshActivity = () => {
    runtime?.setActive(insideActiveZone && !document.hidden);
    if (runtime) {
      bg.dataset.gsState = insideActiveZone && !document.hidden ? 'ready-active' : 'ready-paused';
    }
  };

  const load = (): Promise<void> => {
    if (loadPromise || disposed) return loadPromise ?? Promise.resolve();
    loadObserver?.unobserve(host);
    bg.dataset.gsState = 'loading';
    loadPromise = mountGaussianBackground(bg, pick)
      .then((mountedRuntime) => {
        if (disposed) {
          mountedRuntime?.dispose();
          return;
        }
        runtime = mountedRuntime;
        if (!runtime) {
          bg.dataset.gsState = 'poster-only';
          return;
        }
        bg.classList.add('gs-bg--live');
        refreshActivity();
      })
      .catch((error) => {
        if (disposed) return;
        bg.dataset.gsState = 'failed';
        console.error('[gs-bg] failed', error);
      });
    return loadPromise;
  };

  const dispose = () => {
    if (disposed) return;
    disposed = true;
    bg.dataset.gsDisposed = '1';
    bg.dataset.gsState = 'disposed';
    loadObserver?.disconnect();
    activityObserver?.disconnect();
    runtime?.dispose();
  };

  const getState = () => ({
    placement: bg.dataset.placement ?? '',
    state: bg.dataset.gsState ?? '',
    runtime: runtime?.getState() ?? null,
  });

  const controller = { bg, load, refreshActivity, dispose, getState };
  bg.dataset.gsState = 'waiting';

  if (window.innerWidth < breakpoint) {
    bg.dataset.gsState = 'poster-only';
    return controller;
  }

  if (!('IntersectionObserver' in window)) {
    insideActiveZone = true;
    void load();
    return controller;
  }

  loadObserver = new IntersectionObserver((entries) => {
    if (entries.some((entry) => entry.isIntersecting)) void load();
  }, { rootMargin: '200% 0px' });

  activityObserver = new IntersectionObserver((entries) => {
    const hostEntry = entries.find((entry) => entry.target === host);
    if (!hostEntry) return;
    insideActiveZone = hostEntry.isIntersecting;
    refreshActivity();
  }, { rootMargin: '75% 0px' });

  loadObserver.observe(host);
  activityObserver.observe(host);
  return controller;
}

function firstCodeGaussian(): GaussianMountController | undefined {
  return [...gaussianControllers].find(({ bg }) => bg.dataset.placement === 'hero-right');
}

function attachAll(): void {
  document.querySelectorAll<HTMLElement>('.gs-bg').forEach((bg) => {
    if (bg.dataset.gsAttached === '1') return;
    bg.dataset.gsAttached = '1';
    bg.dataset.gsDisposed = '0';
    const controller = createGaussianMountController(bg);
    if (controller) gaussianControllers.add(controller);
  });

  if (location.hash === '#code') void firstCodeGaussian()?.load();
}

function handleCodeNavigation(event: MouseEvent): void {
  const target = event.target;
  if (!(target instanceof Element)) return;
  const anchor = target.closest<HTMLAnchorElement>('a[href]');
  if (!anchor) return;
  const url = new URL(anchor.href, location.href);
  if (
    url.origin === location.origin &&
    url.pathname === location.pathname &&
    url.search === location.search &&
    url.hash === '#code'
  ) {
    void firstCodeGaussian()?.load();
  }
}

function refreshGaussianVisibility(): void {
  gaussianControllers.forEach((controller) => controller.refreshActivity());
}

function cleanupGaussianBackgrounds(): void {
  gaussianControllers.forEach((controller) => controller.dispose());
  gaussianControllers.clear();
}

window.__gsBgDebug = () => [...gaussianControllers].map((controller) => controller.getState());

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', attachAll, { once: true });
} else {
  attachAll();
}
document.addEventListener('click', handleCodeNavigation);
document.addEventListener('visibilitychange', refreshGaussianVisibility);
document.addEventListener('astro:page-load', attachAll);
document.addEventListener('astro:before-swap', cleanupGaussianBackgrounds);
</script>


