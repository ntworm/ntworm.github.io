---
const { pathname } = Astro.url;
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#work', label: 'Work' },
  { href: '/#code', label: 'Code' },
  { href: '/#contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  return href === '/#work' && pathname.startsWith('/work/');
}
---
<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__logo" aria-label="GW Gabriel Worm — Home">GW</a>
    <nav aria-label="Primary">
      <ul class="nav__list">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              data-nav-section
              class:list={['nav__link', isActive(link.href) && 'is-active']}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import { installSectionNavigation } from '../scripts/nav-section-controller.mjs';

  installSectionNavigation(document);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    isolation: isolate;
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(11, 11, 12, 0.8), rgba(11, 11, 12, 0.26) 68%, transparent);
    opacity: 0.72;
  }
  .nav__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .nav__logo {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--fg-bone);
    border-bottom: 0;
  }
  .nav__logo:hover { color: var(--accent-amber); }
  .nav__list {
    display: flex;
    list-style: none;
    gap: var(--s-5);
  }
  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted-graphite);
    border-bottom: 0;
    transition: color var(--d-fast) var(--ease-out);
  }
  .nav__link:hover, .nav__link.is-active {
    color: var(--fg-bone);
  }
  .nav__link.is-active { border-bottom: 1px solid var(--accent-amber); }

  @media (max-width: 640px) {
    .nav { height: 56px; }
    .nav__list { gap: var(--s-4); }
    .nav__link {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      font-size: 11px;
    }
  }
</style>
