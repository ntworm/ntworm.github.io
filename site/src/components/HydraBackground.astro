---
import { localeFromPath } from '../i18n/locales.mjs';

const linesAndCellsUrl = '/hydra/lines-and-cells.html';
const frameTitle = localeFromPath(Astro.url) === 'pt'
  ? 'Lines and Cells — fundo generativo ao vivo'
  : 'Lines and Cells live generative background';
---

<div class="portfolio-opening__live-bg" aria-hidden="true">
  <div class="portfolio-opening__live-stage">
    <iframe
      src="about:blank"
      data-hydra-src={linesAndCellsUrl}
      title={frameTitle}
      width="640"
      height="360"
      loading="lazy"
      tabindex="-1"
      sandbox="allow-scripts allow-same-origin"
      referrerpolicy="no-referrer"
    ></iframe>
  </div>
</div>

<style>
  .portfolio-opening__live-bg {
    position: absolute;
    top: -18vh;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.72;
    mix-blend-mode: screen;
    background: transparent;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.24) 5%, rgba(0, 0, 0, 0.86) 14%, #000 25%, #000 75%, rgba(0, 0, 0, 0.78) 89%, transparent 100%),
      linear-gradient(180deg, #000 0%, #000 calc(100% - clamp(180px, 32vh, 360px)), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.24) 5%, rgba(0, 0, 0, 0.86) 14%, #000 25%, #000 75%, rgba(0, 0, 0, 0.78) 89%, transparent 100%),
      linear-gradient(180deg, #000 0%, #000 calc(100% - clamp(180px, 32vh, 360px)), transparent 100%);
    mask-composite: intersect;
  }

  .portfolio-opening__live-stage {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .portfolio-opening__live-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(18, 18, 19, 0.46), transparent 34%, transparent 78%, rgba(18, 18, 19, 0.32)),
      linear-gradient(180deg, rgba(18, 18, 19, 0.22), transparent 20%, transparent 80%, rgba(18, 18, 19, 0.44));
  }

  .portfolio-opening__live-bg iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 1;
    opacity: 0.92;
    mix-blend-mode: screen;
    filter: saturate(1.18) contrast(1.12) brightness(0.82) blur(0.55px);
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-opening__live-bg iframe { display: none; }
  }

  @media (max-width: 760px) {
    .portfolio-opening__live-bg {
      top: -12vh;
      bottom: 0;
      width: 100vw;
      opacity: 0.46;
    }
  }
</style>

<script>
  import { createHydraFrameController } from '../scripts/hydra-frame-controller.mjs';

  type HydraSurfaceWindow = Window & {
    __portfolioHydraSurfaceCleanup?: () => void;
  };

  const setupHydraSurface = () => {
    const liveWindow = window as HydraSurfaceWindow;
    liveWindow.__portfolioHydraSurfaceCleanup?.();

    const background = document.querySelector<HTMLElement>('.portfolio-opening__live-bg');
    const stage = background?.querySelector<HTMLElement>('.portfolio-opening__live-stage');
    const iframe = stage?.querySelector<HTMLIFrameElement>('iframe');
    if (!background || !stage || !iframe) return;

    const controller = createHydraFrameController({
      host: background,
      iframe,
      source: iframe.dataset.hydraSrc,
    });
    liveWindow.__portfolioHydraSurfaceCleanup = () => controller.dispose();
  };

  document.addEventListener('astro:page-load', setupHydraSurface);
  document.addEventListener('astro:before-swap', () => {
    (window as HydraSurfaceWindow).__portfolioHydraSurfaceCleanup?.();
  });
  setupHydraSurface();
</script>
