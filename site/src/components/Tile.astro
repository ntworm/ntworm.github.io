---
interface Props {
  act: string;          // "ACT 01"
  title: string;        // "O Compositor"
  role: string;         // "Sound Direction"
  year: string;         // "2024"
  href: string;         // "/work/o-compositor"
  cover?: string;       // path to image, optional
  coverAlt?: string;
  summary?: string;     // 1-2 line description (role + production + context)
  production?: string;  // production / publisher / context line
}

const { act, title, role, year, href, cover, coverAlt = '', summary, production } = Astro.props;
---
<a class="tile" href={href}>
  <div class="tile__media">
    {cover ? (
      <img src={cover} alt={coverAlt} loading="lazy" />
    ) : (
      <div class="tile__placeholder" aria-label="Cover image pending">
        <span class="mono">image pending</span>
      </div>
    )}
  </div>
  <div class="tile__meta">
    <span class="tile__act eyebrow">{act}</span>
    <h3 class="tile__title"><span class="reveal-mask"><span>{title}</span></span></h3>
    <p class="tile__role mono">{role} · {year}</p>
    {summary && <p class="tile__summary">{summary}</p>}
    {production && <p class="tile__production mono">{production}</p>}
  </div>
</a>

<style>
  .tile {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--s-5);
    border-bottom: 0;
    color: inherit;
    align-items: start;
  }
  @media (max-width: 560px) {
    .tile {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
  .tile:hover .tile__title { color: var(--accent-amber); }
  .tile:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .tile__media {
    position: relative;
    overflow: hidden;
    background: rgba(234, 230, 222, 0.04);
    height: 220px;
  }
  .tile__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    pointer-events: none;
    transition: border-color var(--d-base) var(--ease-out);
  }
  .tile:hover .tile__media::after {
    border-color: var(--accent-amber);
  }
  .tile__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.04);
    transition: transform var(--d-slow) var(--ease-out), filter var(--d-base) var(--ease-out);
  }
  .tile:hover .tile__media img {
    transform: scale(1.02);
    filter: grayscale(0) contrast(1);
  }
  .tile__placeholder {
    width: 100%;
    height: 100%;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-noir);
    color: var(--muted-graphite);
  }
  .tile__meta { display: flex; flex-direction: column; gap: var(--s-3); }
  .tile__act { color: var(--accent-amber); }
  .tile__title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.1;
    color: var(--fg-bone);
    transition: color var(--d-fast) var(--ease-out);
  }
  .tile__role {
    color: var(--muted-graphite);
    font-size: var(--t-small);
  }
  .tile__summary {
    color: var(--fg-bone);
    font-size: var(--t-small);
    line-height: 1.45;
    opacity: 0.85;
    margin-top: var(--s-1);
  }
  .tile__production {
    color: var(--muted-graphite);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
