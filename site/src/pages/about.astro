---
import Layout from '../layouts/Layout.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

// Read the owner's portrait photos from /public/portrait at build time.
// Natural sort so '1.jpg' comes before '2.jpg' before '10.jpg'.
const PORTRAIT_DIR = join(process.cwd(), 'public', 'portrait');
const IMG_EXTS = /\.(jpe?g|png|webp|avif|gif)$/i;
function naturalSort(a: string, b: string) {
  const an = a.match(/^(\d+)/)?.[1];
  const bn = b.match(/^(\d+)/)?.[1];
  if (an != null && bn != null) return (+an) - (+bn) || a.localeCompare(b);
  if (an != null) return -1;
  if (bn != null) return 1;
  return a.localeCompare(b);
}
const portraitFiles = (() => {
  try {
    return readdirSync(PORTRAIT_DIR)
      .filter((f) => IMG_EXTS.test(f))
      .sort(naturalSort);
  } catch {
    return [];
  }
})();

// Photos consolidated in a single section between header and manifesto.
// Each photo at natural aspect, in a uniform-width grid. Heights vary
// per image aspect, aligned to the row baseline (align-items: end).
const photoAlt = (i: number) => `Portrait ${i + 1} of ${portraitFiles.length}`;
---

<Layout title="About" image="/portrait/1.jpg">
  <article class="about wrap" data-section="about">
    <header class="about__header">
      <span class="eyebrow">About</span>
      <h1 class="about__title" data-reveal="focus" aria-label="A practice shaped by listening, systems, and collaboration.">
        <span class="reveal-seg">A practice</span>
        <span class="reveal-seg">shaped by</span>
        <span class="reveal-seg reveal-amber">listening</span><span class="reveal-seg">, systems,</span>
        <span class="reveal-seg">and collaboration.</span>
      </h1>
      <p class="about__lead">
        Sound direction, music production, and creative tooling — for cinema, performance,
        and live instruments. Based in Palmas, Tocantins, Brazil.
      </p>
    </header>

    {portraitFiles.length > 0 && (
      <section class="about__portrait" aria-label="Portrait">
        <div class="portrait-grid">
          {portraitFiles.map((file, i) => (
            <figure class={`portrait-cell portrait-cell--${i + 1}`}>
              <img src={`/portrait/${file}`} alt={photoAlt(i)} loading="lazy" />
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="about__manifesto">
      <span class="eyebrow">Manifesto</span>
      <h2 class="about__h2">Three movements, one thread.</h2>
      <p>
        I work at the intersection of film sound, music production, and creative tooling. My practice
        spans three movements: <em>cinema</em> (sound direction, sound design, mixing for short film,
        TV, and feature); <em>music</em> (production, mix, and master for independent Brazilian artists
        and bands, with a focus on Palmas and the Tocantins scene); and <em>code</em> (Max4Live devices,
        generative audiovisual systems, and live instruments).
      </p>
      <p>
        Across all three, the thread is the same: I build instruments — acoustic, digital, conceptual —
        to make work that is specific, situated, and accountable to a place. Currently based in Palmas,
        Tocantins, Brazil. Recently shipped <em><a class="entity-link" href="/work/o-compositor">O Compositor</a></em> (<a class="entity-link" href="https://www.imdb.com/pt/event/ev0074294/2026/1/" target="_blank" rel="noopener noreferrer">Prémio Curtas 2026</a> nominee, Best Composition)
        and the <em><a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a></em> for Luzo Cairo. Author of <em><a class="entity-link" href="/work/rc-surface">RC Surface</a></em>, an MIT-licensed
        Max4Live device for Ableton Live.
      </p>
      <p>
        The path has been geographic as much as it has been technical. Before the engineering work, I
        spent six years (2015–2021) in the Palmas music scene as a composer, guitarist, and producer —
        the band <em><a class="entity-link" href="/work/em-agosto-chove">Em Agosto Chove</a></em> and a rotating seat in the local live circuit.
        From 2019 onward the studio work came in: two and a half years at <em><a class="entity-link" href="/work/arvore-seca">Produtora Árvore Seca</a></em>,
        recording, mixing, and running the festival floor in Palmas — co-creating the <em>Som na Árvore</em> live-sound
        festival and producing <em>Seletiva Bem Ali</em>, <em>Verão Brabo</em>, <em>Wingfuzz Festival</em>,
        <em>Som do Formigueiro</em>, and the <em>Festival Bem Ali</em> cycle. The BA in Sound at Universidade
        Lusófona ran from 2019 to 2025, overlapping with all of it — I lived between Brazil and Lisbon through
        the period, finishing the degree in pieces, and went through REANIMA's small cohort of directors
        and animators during the Lisbon stretches. I returned to Palmas in the middle of 2025 and have been
        based here since, carrying the tools and the habits of two scenes at once.
      </p>
      <p>
        The work threads those scenes through institutions: Lusófona and REANIMA for the audiovisual,
        AMMP for Portuguese TV, Artpalco for the recent series work, the Madison Museum's collection
        for one of the <a class="entity-link" href="/work/fxhash">fxhash</a> pieces, and the Aldir Blanc / PAAR grant for the <a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a>
        production. None of these is a permanent home — they are passages.
      </p>
    </section>

    <section class="about__practice" aria-labelledby="practice-title">
      <span class="eyebrow">Practice</span>
      <h2 id="practice-title" class="about__h2">Four areas, one thread.</h2>
      <div class="practice__grid">
        <article class="practice__item">
          <h3>01 · Film Audio</h3>
          <p>
            Sound direction, design, and mix for short film, TV series, animation, and documentary.
            BA in Sound at Universidade Lusófona (2019–2025), completed across multiple stretches
            between Brazil and Lisbon. The REANIMA program — a small cohort of directors and
            animators — ran during the Lisbon stretches.
          </p>
          <p>
            Recent direction: <em><a class="entity-link" href="/work/o-compositor">O Compositor</a></em> (<a class="entity-link" href="https://www.imdb.com/pt/event/ev0074294/2026/1/" target="_blank" rel="noopener noreferrer">Prémio Curtas 2026</a> nominee, Best Composition),
            the <em><a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a></em> for Luzo Cairo, and the second episode of <em><a class="entity-link" href="/work/trisal">Trisal</a></em> for
            Artpalco. The pace and rigour of working alongside REANIMA's directors and animators
            recalibrated what I thought a single piece of sound work could be.
          </p>
        </article>

        <article class="practice__item">
          <h3>02 · Music Production</h3>
          <p>
            Production, mix, and master for independent Brazilian artists, with a focus on Palmas and
            the Tocantins scene. Aldir Blanc / PAAR 2024 grant recipient for the <em><a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a></em>
            production. Live recording sessions out of the <em><a class="entity-link" href="/work/arvore-seca">Produtora Árvore Seca</a></em> studio in Palmas, 2019–2021.
          </p>
          <p>
            Small-scale on purpose — singles and EPs, mostly, with the occasional longer record when
            the timing is right. The work is shaped by the scene that surrounds it: the same handful
            of mics and preamps showing up across every session, the bands I produced for one season
            becoming the session players on the next record. The Palmas chapter still feeds the
            Palmas chapter — <em><a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a></em> is the same lineage as the <em><a class="entity-link" href="/work/bem-ali-sessions">Bem Ali Sessions</a></em> cycle, just
            with the production scale lifted by the Aldir Blanc grant.
          </p>
        </article>

        <article class="practice__item">
          <h3>03 · Creative Coding</h3>
          <p>
            Max4Live devices and generative audiovisual systems built around real-time signal flow.
            <em><a class="entity-link" href="/work/rc-surface">RC Surface</a></em> — a Max4Live device that turns any phone browser into a wireless MIDI
            + multi-sensor controller for Ableton Live (12 performance pads, two physics XY pads,
            knobs & faders, sensor mappings for motion / orientation / audio / vision) — is the
            most-shipped piece. MIT-licensed, open source.
          </p>
          <p>
            Behind it: <em>Setlist v1</em> (in development), <em><a class="entity-link" href="/work/lucy">LUCY</a></em> (a long-running Max + Hydra.js
            generative automaton published on Teia), <em><a class="entity-link" href="/work/eletronik-fields">Eletronik Fields</a></em> (a live performance that
            converts electromagnetic signals into MIDI via a magnetic induction coil, with real-time
            oscilloscope visuals projected in a dark room), and ~30 generative pieces on <a class="entity-link" href="/work/fxhash">fxhash</a> as
            <span class="mono">nt_worm</span>. The tools feed the art and the art feeds the tools —
            they share patches, modules, and the same stubbornness about real-time.
          </p>
        </article>

        <article class="practice__item">
          <h3>04 · Live &amp; Experimental</h3>
          <p>
            Festival curation, livecoding performances, and installations. Co-founder of
            <em><a class="entity-link" href="/work/arvore-seca">Produtora Árvore Seca</a></em> (Palmas) — two and a half years of studio, stage, and
            collective work that turned the local scene into a working production circuit.
          </p>
          <p>
            Co-created <em>Som na Árvore</em>, the Tocantins live-sound festival, for its 2019
            edition, and produced or engineered the rest of the Palmas festival circuit that ran
            through the Árvore Seca era: <em>Seletiva Bem Ali</em> (curator + engineer, 2019),
            <em>Verão Brabo</em> (curator + engineer, 2019), <em>Wingfuzz Festival</em>
            (curator + engineer, 2019), <em>Som do Formigueiro</em> (engineer, 2019), and
            <em>Festival Bem Ali</em> (engineer + producer of the Bem Ali Sessions cycle, 2021).
            The practice side of all this is what keeps the studio work honest: a piece either
            survives the room or it doesn't. Working in front of a paying audience on a borrowed
            PA, with the cable you forgot in the car, is the fastest way to find the flaws in
            your software.
          </p>
        </article>
      </div>
    </section>

    <section class="about__recognition" aria-labelledby="recognition-title">
      <span class="eyebrow">Recognition</span>
      <h2 id="recognition-title" class="about__h2">A few notes that came back.</h2>
      <ul class="recognition__list">
        <li>
          <span class="recognition__year mono">2026</span>
          <div>
            <strong><a class="entity-link" href="https://www.imdb.com/pt/event/ev0074294/2026/1/" target="_blank" rel="noopener noreferrer">Prémio Curtas 2026</a></strong> — nominee, Best Composition, for
            <em><a class="entity-link" href="/work/o-compositor">O Compositor</a></em> (BA short film, Universidade Lusófona, 2024).
          </div>
        </li>
        <li>
          <span class="recognition__year mono">2024</span>
          <div>
            <strong>Aldir Blanc / PAAR 2024</strong> — production grant for the
            <em><a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a></em> by Luzo Cairo (six tracks, 2025).
          </div>
        </li>
        <li>
          <span class="recognition__year mono">2021</span>
          <div>
            <strong>Festival Bem Ali 2021</strong> — sound engineer and producer of the
            <em><a class="entity-link" href="/work/bem-ali-sessions">Bem Ali Sessions</a></em> cycle (five music videos from local Palmas bands).
          </div>
        </li>
        <li>
          <span class="recognition__year mono">2019</span>
          <div>
            <strong>Festival Som na Árvore 2019</strong> — co-founder and head of sound
            for the inaugural Tocantins live-sound festival.
          </div>
        </li>
        <li>
          <span class="recognition__year mono">2022</span>
          <div>
            <strong>Madison Museum collection</strong> — edition #37 of
            <em><a class="entity-link" href="/work/kakofoni-orquestra">Kakofoni Orquestra</a></em> (fxhash, 2022). The version most people will have seen on social
            media.
          </div>
        </li>
      </ul>
    </section>

    <section class="about__credits">
      <span class="eyebrow">Selected Credits</span>
      <h2 class="about__h2">What this work has looked like, year by year.</h2>
      <ul>
        <li><span class="mono">2026</span><span class="about__credits-text"><a class="entity-link" href="/work/trisal">Trisal</a> (TV series ep 2, <a class="entity-link" href="https://grupoartpalco.com.br" target="_blank" rel="noopener noreferrer">Artpalco</a>) — Sound Director</span></li>
        <li><span class="mono">2026</span><span class="about__credits-text"><a class="entity-link" href="/work/a-quermesse">A Quermesse</a> (feature, <a class="entity-link" href="https://www.instagram.com/borboletasfilmes/" target="_blank" rel="noopener noreferrer">Borboletas+MZN</a>) — Sound Assistant</span></li>
        <li><span class="mono">2025</span><span class="about__credits-text"><a class="entity-link" href="/work/ticha-penicheiro">Ticha Penicheiro</a> (documentary) — Sound Editor</span></li>
        <li><span class="mono">2025</span><span class="about__credits-text"><a class="entity-link" href="/work/ep-rinoceronte">EP Rinoceronte</a> (<a class="entity-link" href="https://luzocairo.bandcamp.com/" target="_blank" rel="noopener noreferrer">Luzo Cairo</a>) — Producer + Mix/Master</span></li>
        <li><span class="mono">2025</span><span class="about__credits-text"><a class="entity-link" href="/work/this-feminine-side">This Feminine Side</a> (<a class="entity-link" href="https://www.re-anima.pt" target="_blank" rel="noopener noreferrer">REANIMA</a> audiovisual, Alice's master's thesis film) — Sound Director + Sound Design + Editing (Miguel Colimão, sound assistant)</span></li>
        <li><span class="mono">2024–25</span><span class="about__credits-text"><a class="entity-link" href="/work/o-clube">O Clube</a> S6+S7 (TV series, <a class="entity-link" href="https://www.ammp.pt" target="_blank" rel="noopener noreferrer">AMMP</a>) — Sound Editor</span></li>
        <li><span class="mono">2024</span><span class="about__credits-text"><a class="entity-link" href="/work/o-compositor">O Compositor</a> (BA short, recorded with orchestra) — Sound Director</span></li>
        <li><span class="mono">2023</span><span class="about__credits-text"><a class="entity-link" href="/work/el-tono-del-mar">El Tono Del Mar</a> (<a class="entity-link" href="https://www.re-anima.pt" target="_blank" rel="noopener noreferrer">REANIMA</a>) — Sound Assistant</span></li>
        <li><span class="mono">2024</span><span class="about__credits-text"><a class="entity-link" href="/work/invasao-do-pequi">Invasão do Pequi</a> (music video / album track) — Artist (via <a class="entity-link" href="/work/em-agosto-chove">Em Agosto Chove</a>) + Mix Engineer</span></li>
        <li><span class="mono">2024</span><span class="about__credits-text"><a class="entity-link" href="/work/bed-time">Bed Time</a> (horror short) — Composer + Sound Mixer</span></li>
        <li><span class="mono">2024</span><span class="about__credits-text"><a class="entity-link" href="/work/unconscious-vision">Unconscious Vision</a> (BA short, Universidade Lusófona) — Sound Designer + Sound Mixer</span></li>
        <li><span class="mono">2024</span><span class="about__credits-text"><a class="entity-link" href="/work/caio">Caio</a> (BA short, Universidade Lusófona) — Remix Engineer</span></li>
        <li><span class="mono">2025</span><span class="about__credits-text"><a class="entity-link" href="/work/unveiling-new-futures">Unveiling New Futures</a> (2 international ads, Universidade Lusófona) — Sound Director + Composer</span></li>
        <li><span class="mono">2024</span><span class="about__credits-text"><a class="entity-link" href="/work/futuro-realizado">Futuro Realizado</a> (Lusófona advertisement) — Sound Designer</span></li>
        <li><span class="mono">2021</span><span class="about__credits-text"><a class="entity-link" href="/work/bem-ali-sessions">Bem Ali Sessions</a> (5 music videos, Festival Bem Ali, Palmas) — Sound engineer + Producer</span></li>
        <li><span class="mono">2019–21</span><span class="about__credits-text"><a class="entity-link" href="/work/arvore-seca">Árvore Seca</a> — Sound engineer + Producer + Festival co-founder (Som na Árvore 2019, Seletiva Bem Ali, Verão Brabo, Wingfuzz, Som do Formigueiro)</span></li>
        <li><span class="mono">2015–21</span><span class="about__credits-text"><a class="entity-link" href="/work/em-agosto-chove">Em Agosto Chove</a> (band, Palmas) — Composer + Guitarist + Producer</span></li>
        
      </ul>
      <a href="mailto:gabrielworm@gmail.com" class="about__contact">Get in touch →</a>
    </section>
  </article>
</Layout>

<style>
  .about { padding-top: var(--s-8); padding-bottom: var(--s-10); }
  .about__header { margin-bottom: var(--s-9); max-width: 80%; }
  .about__title {
    font-size: var(--t-display);
    margin-top: var(--s-3);
    letter-spacing: -0.02em;
  }
  .about__lead {
    margin-top: var(--s-5);
    font-size: var(--t-h3);
    line-height: 1.4;
    color: var(--muted-graphite);
    max-width: 50ch;
  }

  /* Portrait grid — 4 photos consolidated at the top (between
     header and manifesto). All cells are uniform 1:1 squares,
     each image fills its cell via cover (no letterbox, no
     uneven row heights). Mixed source aspects crop at the
     edges; this is the 'padronizadinhas, mesmo tamanho' look
     owner requested on the 4th iteration. */
  .about__portrait { margin: var(--s-9) 0 var(--s-10); }
  .portrait-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-2);
  }
  .portrait-cell {
    margin: 0;
    aspect-ratio: 1 / 1;
    background: var(--bg-noir);
    border: 1px solid var(--muted-graphite);
    overflow: hidden;
  }
  .portrait-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.04);
  }
  @media (max-width: 880px) {
    .portrait-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .portrait-grid { grid-template-columns: 1fr; }
  }

  .about__manifesto { margin-bottom: var(--s-10); max-width: 70ch; }
  .about__manifesto p {
    margin-top: var(--s-4);
    font-size: var(--t-body);
    line-height: 1.7;
  }
  .about__manifesto em { color: var(--accent-amber); font-style: normal; font-weight: 500; }

  .about__practice { margin-bottom: var(--s-10); }
  .about__h2 {
    font-size: var(--t-h2);
    color: var(--fg-bone);
    font-weight: 500;
    margin-top: var(--s-3);
    margin-bottom: var(--s-6);
    max-width: 30ch;
  }
  .practice__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-7) var(--s-6);
  }
  .practice__item h3 {
    font-size: var(--t-h3);
    color: var(--accent-amber);
    margin-bottom: var(--s-3);
    letter-spacing: -0.005em;
  }
  .practice__item p {
    font-size: var(--t-body-sm);
    line-height: 1.65;
    margin-bottom: var(--s-3);
  }
  .practice__item p:last-child { margin-bottom: 0; }
  .practice__item em { color: var(--accent-amber); font-style: normal; font-weight: 500; }
  @media (max-width: 880px) {
    .practice__grid { grid-template-columns: 1fr; gap: var(--s-6); }
  }

  .about__recognition { margin-bottom: var(--s-10); }
  .recognition__list {
    list-style: none;
    margin-top: var(--s-5);
    border-top: 1px solid var(--muted-graphite);
  }
  .recognition__list li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--muted-graphite);
    font-size: var(--t-body-sm);
    line-height: 1.6;
  }
  .recognition__year {
    color: var(--muted-graphite);
    padding-top: 2px;
  }
  .recognition__list strong { color: var(--fg-bone); font-weight: 500; }
  .recognition__list em { color: var(--accent-amber); font-style: normal; font-weight: 500; }

  .about__credits { margin-bottom: var(--s-9); }
  .about__credits ul {
    list-style: none;
    margin: var(--s-5) 0;
  }
  .about__credits li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-top: 1px solid var(--muted-graphite);
    font-size: var(--t-body-sm);
  }
  .about__credits li:last-child { border-bottom: 1px solid var(--muted-graphite); }
  .about__credits .mono { color: var(--muted-graphite); }
  .about__contact {
    display: inline-block;
    margin-top: var(--s-5);
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.05em;
  }
  .about__contact:hover { color: var(--fg-bone); }

  /* Cinematic focus reveal: phrase groups drift out of a shallow blur. */
  .about__title { min-height: 1.2em; }
  .reveal-seg { display: inline-block; margin-right: 0.18em; }
  .reveal-seg.reveal-amber { color: var(--accent-amber); }
  .about__title[data-reveal-initialized="true"] .reveal-seg {
    opacity: 0;
    filter: blur(16px);
    transform: translateX(-14px) translateY(6px);
  }
  .about__title[data-reveal-ready="true"] .reveal-seg {
    animation: about-focus-in 780ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(140ms + var(--reveal-i, 0) * 105ms);
  }
  @keyframes about-focus-in {
    to { opacity: 1; filter: blur(0); transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about__title[data-reveal-initialized="true"] .reveal-seg {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }
  }
</style>
