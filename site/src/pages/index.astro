---
import Layout from '../layouts/Layout.astro';
import Tile from '../components/Tile.astro';
import { getProjectMedia } from '../utils/project-images';

// Selected Work — split into two sections (Audiovisual + Performance & Installations).
// Order inside each section is chronological reverse (most recent first).

// === Audiovisual section (13 cases, 2023–2026) ===
const audiovisualCases = [
  {
    slug: 'a-quermesse', act: 'ACT 01', title: 'A Quermesse',
    role: 'Sound Assistant', year: '2026', type: 'Feature film',
    production: 'MZN Filmes + Borboletas Filmes · dir. Juliane Almeida',
    summary: 'Tocantins feature film by Juliane Almeida, with Christian Malheiros in the lead role. Sound Assistant on set during principal photography (April–May 2026).',
  },
  {
    slug: 'trisal', act: 'ACT 02', title: 'Trisal — episode 2',
    role: 'Sound Director', year: '2026', type: 'TV Series',
    production: 'Artpalco Produções / Grupo Tukan',
    summary: 'Sound direction end-to-end for “Isso de novo não tem nada!”, a Tocantins-made comedy about contemporary relationships. Premiered at CineSesc Araguaína on 10 June 2026.',
  },
  {
    slug: 'unveiling-new-futures', act: 'ACT 03', title: 'Unveiling New Futures',
    role: 'Sound Director + Composer', year: '2025', type: 'Advertisement (international)',
    production: 'Universidade Lusófona',
    summary: "Two ads in Lusófona's 2025 international campaign ('Descobrir Novos Futuros'). Sound Director + Composer — captured production sound, composed original score, mixed and delivered both.",
  },
  {
    slug: 'ticha-penicheiro', act: 'ACT 04', title: 'Feel the Magic – Ticha Penicheiro',
    role: 'Sound Editor', year: '2025', type: 'Documentary',
    production: 'Trix / Betclic Studios · dir. André Braz',
    summary: 'Intimate documentary on Portuguese basketball legend Ticha Penicheiro, premiered at Tribeca Festival Lisboa 2025. Sound-effects editing with Foley and ambiences.',
  },
  {
    slug: 'this-feminine-side', act: 'ACT 05', title: 'This Feminine Side',
    role: 'Sound Director + Sound Design + Editing', year: '2025', type: 'Animated documentary',
    production: 'RE:Anima / Lusófona Films',
    summary: 'Animated documentary by Alice Siniscalchi about Lisbon’s LGBTQ+ artistic scene and femininity beyond the binary. Selected for the ITFS 2026 Student Competition.',
  },
  {
    slug: 'o-clube', act: 'ACT 06', title: 'O Clube (S6 + S7)',
    role: 'Sound Editor', year: '2024–2025', type: 'TV Series',
    production: 'AMMP — Audio & Music for Motion Picture',
    summary: 'Portuguese TV series streaming on OPTO/SIC. Sound Editor on seasons 6 and 7 at AMMP: production sound recording, Foley, ambiences, and sound-effects editing across the 2025 seasons.',
  },
  {
    slug: 'bed-time', act: 'ACT 07', title: 'Bed Time',
    role: 'Composer + Sound Mixer', year: '2024', type: 'Short film (horror)',
    production: 'Lisbon, Portugal',
    summary: 'Horror short, 2024. Composer + Sound Mixer — wrote the original score and handled the final mix.',
  },
  {
    slug: 'caio', act: 'ACT 08', title: 'Caio',
    role: 'Remix Engineer', year: '2024', type: 'BA short film',
    production: 'Universidade Lusófona',
    summary: 'BA short from Lusófona (Lisbon). Remix Engineer — shaped the final re-mix of the existing soundtrack for delivery.',
  },
  {
    slug: 'futuro-realizado', act: 'ACT 09', title: 'Futuro Realizado',
    role: 'Sound Designer', year: '2024', type: 'Advertisement',
    production: 'Universidade Lusófona',
    summary: "Lusófona 2024 advertisement. Sound Designer on the spot — full sound design from brief to delivery.",
  },
  {
    slug: 'o-compositor', act: 'ACT 10', title: 'O Compositor',
    role: 'Sound Direction', year: '2024', type: 'BA short film',
    production: 'Universidade Lusófona',
    summary: '18-minute horror short selected for FESTin and MOTELX 2025. Sound direction end-to-end, orchestral composition and recording, editing, design, and final mix. Prémio Curtas 2026 nominee, Best Composition.',
  },
  {
    slug: 'ai-am', act: 'ACT 11', title: 'A.I. AM',
    role: 'Composer', year: '2024', type: 'Short Film (sci-fi)',
    production: 'Universidade Lusófona',
    summary: 'Post-apocalyptic sci-fi short directed by Danny J, about Alpha-30 and survivor Mew trying to enter a Safe Zone controlled by an obsolete AI sentry. Original score composer.',
  },
  {
    slug: 'unconscious-vision', act: 'ACT 12', title: 'Unconscious Vision',
    role: 'Sound Designer + Sound Mixer', year: '2024', type: 'BA short film (horror)',
    production: 'Universidade Lusófona',
    summary: 'BA horror short from Lusófona (Lisbon). Sound Designer + Sound Mixer — full sound design through to final mix.',
  },
  {
    slug: 'el-tono-del-mar', act: 'ACT 13', title: 'El Tono Del Mar',
    role: 'Sound Assistant', year: '2023', type: 'Animation',
    production: 'Universidade Lusófona · REANIMA',
    summary: 'Mica Bolaños Meade’s award-winning animation about migration and distance. Foley, sound-effects editing, and sound design; Best Mexican Student Short Film at Pixelatl 2024.',
  },
];

// === Music section (5 entries: solo + bands + producer era, 2015–2025) ===
// Reverse chronological order. Each entry has its own case page when
// there is enough context to warrant one.
const musicCases = [
  {
    slug: 'ep-rinoceronte', act: 'ACT 01', title: 'EP Rinoceronte (Luzo Cairo)',
    role: 'Producer + Mix/Master', year: '2025', type: 'EP — 6 tracks',
    production: 'Política Nacional Aldir Blanc / PAAR 2024',
    summary: 'Six-track EP for Luzo Cairo. Producer, mix, and master across all tracks, plus pre-production recording and the live stream. Released on Bandcamp and Spotify in late 2025.',
  },
  {
    slug: 'invasao-do-pequi', act: 'ACT 02', title: 'Invasão do Pequi',
    role: 'Artist + Mix Engineer', year: '2024', type: 'Music video / Album track',
    production: 'Local production, Palmas/TO',
    summary: 'Music video and album track from Palmas, 2024. Artist via Em Agosto Chove + Mix Engineer on the album tracks.',
  },
  {
    slug: 'arvore-seca', act: 'ACT 03', title: 'Árvore Seca',
    role: 'Sound engineer + Producer + Festival co-founder', year: '2019–2021', type: 'Producer era',
    production: 'Produtora Árvore Seca, Palmas/TO',
    summary: 'Two and a half years as technical sound + producer at Árvore Seca. Co-founded Som na Árvore 2019; produced Seletiva Bem Ali, Verão Brabo, Wingfuzz, Som do Formigueiro. Studio + live engineering.',
  },
  {
    slug: 'bem-ali-sessions', act: 'ACT 04', title: 'Bem Ali Sessions',
    role: 'Sound engineer + Producer', year: '2021', type: '5 music videos',
    production: 'Festival Bem Ali, Palmas/TO',
    summary: 'Sound engineer and producer on the Bem Ali Sessions cycle — five music videos from local bands, recorded and mixed as part of the Festival Bem Ali 2021.',
  },
  {
    slug: 'em-agosto-chove', act: 'ACT 05', title: 'Em Agosto Chove',
    role: 'Composer + Guitarist + Producer', year: '2015–2021', type: 'Band (Palmas/TO)',
    production: 'Personal project',
    summary: 'My band, 2015–2021. Three singles, one album, and a live recording at Bem Ali Sessions.',
  },
];

// === Performance & Installations section (4 cases, 2021–2026) ===
const codeCases = [
  {
    slug: 'fxhash', act: 'ACT 01', title: 'fxhash',
    role: 'Creator (as nt_worm)', year: '2022–2026', type: 'Generative art platform',
    production: 'Hydra.js + Web Audio API',
    summary: '~30 generative pieces on fxhash as nt_worm. Hydra.js visuals, Web Audio + OSC reactivity. Highlights include KAKOFONI ORQUESTRA (edition #37 acquired by the Madison Museum).',
  },
  {
    slug: 'eletronik-fields', act: 'ACT 02', title: 'Eletronik Fields',
    role: 'Creator', year: '2023', type: 'Generative audiovisual / Installation',
    production: 'Personal · Hydra.js + Max 8',
    summary: 'Live performance that converts electromagnetic signals to music via a magnetic induction coil. Max 8 patches for sound-to-MIDI mapping, with real-time oscilloscope visuals projected in a dark room.',
  },
  {
    slug: 'kakofoni-orquestra', act: 'ACT 03', title: 'Kakofoni Orquestra',
    role: 'Collaborator + Programmer (audio + reactivity)', year: '2022', type: 'Generative audiovisual',
    production: 'With Rangga Purnama Aji (visuals)',
    summary: 'Generative audiovisual on fxhash. Hydra.js visuals by Rangga Purnama Aji, audio and reactivity by me (Hydra → Ableton/MaxLive). Inspired by Brian Eno\'s Ambient 1. Edition #37 acquired by the Madison Museum.',
  },
  {
    slug: 'lucy', act: 'ACT 04', title: 'LUCY',
    role: 'Creator', year: '2021', type: 'Digital Arts (generative audiovisual)',
    production: 'Max + Ableton Live + Hydra.js',
    summary: 'Autonomous generative automaton in Max that composes its own audiovisual pieces. Probabilistic MIDI control with scale maps and transitions, Hydra.js reactive to audio. Published as the `lucy` pseudonym on Teia.',
  },
];

const audiovisualWithMedia = audiovisualCases.map((c) => ({ ...c, media: getProjectMedia(c.slug) }));
const musicWithMedia = musicCases.map((c) => ({ ...c, media: getProjectMedia(c.slug) }));
const codeWithMedia = codeCases.map((c) => ({ ...c, media: getProjectMedia(c.slug) }));
const rcSurfaceCover = getProjectMedia('rc-surface').cover;

// All 17 projects for the About-side spotlight. Each gets a staggered
// animation-delay so one cover is in focus at a time, cross-fading
// through all of them in array order. Filtered to entries with a real
// cover so the loop never lands on a placeholder.
const spotlightSlugs = new Set([
  'a-quermesse',
  'trisal',
  'ticha-penicheiro',
  'o-clube',
  'o-compositor',
  'eletronik-fields',
  'rc-surface',
]);

const shufflerCases = [
  ...audiovisualCases.map((c) => ({ slug: c.slug, title: c.title, role: c.role, year: c.year })),
  ...musicCases.map((c) => ({ slug: c.slug, title: c.title, role: c.role, year: c.year })),
  ...codeCases.map((c) => ({ slug: c.slug, title: c.title, role: c.role, year: c.year })),
  { slug: 'rc-surface', title: 'RC Surface', role: 'Max4Live Author', year: '2025' },
]
  .map((c) => ({ ...c, media: getProjectMedia(c.slug) }))
  .filter((c) => spotlightSlugs.has(c.slug) && !!c.media.cover);

// Spotlight cycle = n × stagger so every 6s slot is filled by a cell (no gap).
// Auto-derived from cell count so adding a new project recomputes the cycle.
// Keyframe percentages below assume visible window = stagger; if you change
// the keyframe, recompute 1.2/cycle%, 5.4/cycle%, 6/cycle% to match.
const spotlightCycleSeconds = shufflerCases.length * 6;
---
<Layout title="Sound & Code" image="/portrait/1.jpg">
  <section class="hero wrap" data-section="hero" aria-labelledby="hero-title">
    <div class="hero__text">
      <span class="eyebrow hero__eyebrow">Sound Editor · Artist</span>
      <h1 id="hero-title" class="hero__title" data-reveal="cut" aria-label="Sound direction, music production, and creative tooling.">
        <span class="reveal-line"><span class="reveal-seg">Sound direction,</span></span>
        <span class="reveal-line"><span class="reveal-seg">music production,</span></span>
        <span class="reveal-line"><span class="reveal-seg reveal-amber">and creative tooling.</span></span>
      </h1>
      <p class="hero__tagline">
        For cinema, performance, and live instruments.
      </p>
      <p class="hero__signature mono">Gabriel Worm · Palmas, Tocantins, Brazil</p>
      <a href="#work" class="hero__cta" aria-label="Skip to Selected Work">
        <span class="mono">Selected Work</span>
        <span class="hero__arrow" aria-hidden="true">↓</span>
      </a>
    </div>
    <figure class="hero__portrait">
      <img src="/portrait/1.jpg" alt="Portrait of Gabriel Worm" loading="eager" width="1440" height="1440" />
    </figure>
  </section>

  <section class="currently wrap" aria-labelledby="currently-title" data-fade-in>
    <header class="currently__header">
      <span class="eyebrow">Currently</span>
      <h2 id="currently-title" class="currently__title">In progress</h2>
    </header>
    <a class="currently-card" href="/work/rc-surface">
      <div class="currently-card__cover">
        {rcSurfaceCover ? (
          <img src={rcSurfaceCover} alt="RC Surface — cover" loading="eager" width="1920" height="1080" />
        ) : (
          <div class="currently-card__placeholder" aria-label="Cover image pending">
            <span class="mono">image pending</span>
          </div>
        )}
      </div>
      <div class="currently-card__meta">
        <span class="currently-card__act eyebrow">NOW 01</span>
        <h3 class="currently-card__title">RC Surface — Max4Live device</h3>
        <p class="currently-card__role mono">Max4Live Author · Ableton Live extension · MIT-licensed</p>
        <p class="currently-card__desc">
          RC Surface turns any phone browser into a wireless MIDI + multi-sensor controller for Ableton Live — 12 performance pads, two physics XY pads, knobs & faders, sensor mappings (motion, orientation, audio, vision), in-browser mapping editor. Built on the Ableton Extensions SDK. Open source on GitHub.
        </p>
        <span class="currently-card__cta mono">Open case →</span>
      </div>
    </a>
  </section>

  <section class="about-mini wrap" aria-labelledby="about-mini-title" data-fade-in>
    <div class="about-mini__text">
      <span class="eyebrow">About</span>
      <h2 id="about-mini-title" class="about-mini__title">A sound director working between cinema, music, and code.</h2>
      <p>
        I work at the intersection of film sound, music production, and creative tooling — composing, recording,
        mixing, and building instruments for cinema, performance, and live instruments. Currently based in
        Palmas, Tocantins, Brazil. Recently shipped <em>O Compositor</em> (Prémio Curtas 2026 nominee, Best
        Composition) and the EP Rinoceronte for Luzo Cairo. Author of <em>RC Surface</em>, a Max4Live device for
        Ableton Live.
      </p>
      <ul class="about-mini__tags" aria-label="Practice areas">
        <li>Film Audio</li>
        <li>Music Production</li>
        <li>Creative Coding</li>
        <li>Live / Experimental</li>
      </ul>
      <a href="/about" class="about-mini__more">Read more →</a>
    </div>
    <div class="about-mini__shuffler" role="group" aria-label="Project spotlight" style={`--spotlight-cycle: ${spotlightCycleSeconds}s`}>
      {shufflerCases.map((c, i) => (
        <a
          href={`/work/${c.slug}`}
          class="spotlight-cell"
          style={`--i: ${i};`}
          aria-label={`${c.title} — ${c.role} (${c.year})`}
          title={`${c.title} — ${c.role} (${c.year})`}
        >
          <img src={c.media.cover} alt="" loading="lazy" width={c.media.coverType === 'video' ? undefined : 480} />
          <div class="spotlight-caption">
            <span class="spotlight-title">{c.title}</span>
            <span class="spotlight-meta mono">{c.role} · {c.year}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="work" class="work wrap" data-section="audiovisual" aria-labelledby="audiovisual-title" data-fade-in>
    <header class="work__header">
      <span class="eyebrow">Selected Work</span>
      <h2 id="audiovisual-title" class="work__title reveal-mask"><span>Audiovisual · 2023 — 2026</span></h2>
    </header>
    <div class="work__grid work__grid--2col">
      {audiovisualWithMedia.map(c => (
        <Tile
          act={c.act}
          title={c.title}
          role={c.role}
          year={c.year}
          href={`/work/${c.slug}`}
          cover={c.media.cover}
          coverAlt={`${c.title} — cover`}
          summary={c.summary}
          production={c.production}
        />
      ))}
    </div>
  </section>

  <section class="work wrap" data-section="music" aria-labelledby="music-title" data-fade-in>
    <header class="work__header">
      <span class="eyebrow">Selected Work</span>
      <h2 id="music-title" class="work__title reveal-mask"><span>Music · 2015 — 2025</span></h2>
    </header>
    <div class="work__grid work__grid--2col">
      {musicWithMedia.map(c => (
        <Tile
          act={c.act}
          title={c.title}
          role={c.role}
          year={c.year}
          href={`/work/${c.slug}`}
          cover={c.media.cover}
          coverAlt={`${c.title} — cover`}
          summary={c.summary}
          production={c.production}
        />
      ))}
    </div>
  </section>

  <section class="work wrap" data-section="code" aria-labelledby="code-title" data-fade-in>
    <header class="work__header">
      <span class="eyebrow">Selected Work</span>
      <h2 id="code-title" class="work__title reveal-mask"><span>Performance &amp; Installations · 2021 — 2026</span></h2>
    </header>
    <div class="work__grid work__grid--2col">
      {codeWithMedia.map(c => (
        <Tile
          act={c.act}
          title={c.title}
          role={c.role}
          year={c.year}
          href={`/work/${c.slug}`}
          cover={c.media.cover}
          coverAlt={`${c.title} — cover`}
          summary={c.summary}
          production={c.production}
        />
      ))}
    </div>
  </section>

  </Layout>

<style>
  /* Hero */
  .hero {
    padding-top: var(--s-7);
    padding-bottom: var(--s-7);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-8);
    align-items: center;
  }
  .hero__eyebrow { margin-bottom: var(--s-5); display: block; }
  .hero__title {
    font-size: clamp(48px, 6.4vw, 88px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    margin-bottom: var(--s-5);
    color: var(--fg-bone);
  }
  .hero__title .reveal-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__title .reveal-seg {
    display: block;
    white-space: nowrap;
  }
  .hero__title .reveal-amber { color: var(--accent-amber); }
  .hero__title[data-reveal-initialized="true"] .reveal-seg {
    opacity: 0;
    transform: translateY(112%) skewY(2deg);
  }
  .hero__title[data-reveal-ready="true"] .reveal-seg {
    animation: hero-cut-in 620ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(120ms + var(--reveal-i, 0) * 115ms);
  }
  @keyframes hero-cut-in {
    to { opacity: 1; transform: none; }
  }
  .hero__tagline {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.4;
    color: var(--fg-bone);
    max-width: 32ch;
    margin-bottom: var(--s-4);
  }
  .hero__signature { color: var(--muted-graphite); margin-bottom: var(--s-6); }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--accent-amber);
    border-bottom: 0;
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .hero__cta:hover { color: var(--fg-bone); }
  .hero__arrow { font-size: 20px; transition: transform var(--d-base) var(--ease-out); }
  .hero__cta:hover .hero__arrow { transform: translateY(4px); }
  .hero__cta:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .hero__portrait { margin: 0; }
  .hero__portrait img {
    display: block;
    width: auto;
    height: auto;
    max-width: 220px;
    max-height: 280px;
    filter: grayscale(0.15) contrast(1.04);
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; gap: var(--s-6); }
    .hero__title { max-width: 11ch; font-size: clamp(44px, 13vw, 72px); }
    .hero__title .reveal-seg { white-space: normal; }
    .hero__portrait { max-width: 180px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title[data-reveal-initialized="true"] .reveal-seg {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* About mini */
  .about-mini {
    padding-top: var(--s-7);
    padding-bottom: var(--s-7);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--s-8);
    align-items: start;
  }
  .about-mini__text { min-width: 0; }
  .about-mini__title {
    font-size: var(--t-h2);
    max-width: 24ch;
    margin: var(--s-3) 0 var(--s-5);
  }
  .about-mini p { color: var(--fg-bone); }
  .about-mini em { color: var(--accent-amber); font-style: normal; font-weight: 500; }
  .about-mini__tags {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    list-style: none;
    margin: var(--s-5) 0;
  }
  .about-mini__tags li {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--fg-bone);
    border: 1px solid var(--muted-graphite);
    padding: var(--s-1) var(--s-3);
    border-radius: 2px;
    transition: border-color var(--d-base) var(--ease-out), color var(--d-fast) var(--ease-out);
  }
  .about-mini__tags li:hover {
    border-color: var(--accent-amber);
    color: var(--accent-amber);
  }
  .about-mini__more {
    display: inline-block;
    margin-top: var(--s-3);
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.05em;
  }

  /* Side spotlight — seven project covers in 6s slots. Each incoming
     image fades up for 1.4s while the outgoing image fades down over the
     same interval. Their combined opacity therefore never falls to black.
     Pure opacity fade, no transform or z-index manipulation. */
  .about-mini__shuffler {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--muted-graphite);
    background: var(--bg-noir);
  }
  .spotlight-cell {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    opacity: 0;
    animation: spotlight-cycle var(--spotlight-cycle, 138s) linear infinite;
    animation-delay: calc(var(--i) * -6s);
    will-change: opacity;
  }
  .spotlight-cell:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: -4px;
  }
  .spotlight-cell img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .spotlight-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--s-5) var(--s-4) var(--s-4);
    background: linear-gradient(to top, rgba(11, 11, 12, 0.85), rgba(11, 11, 12, 0));
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .spotlight-title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    color: var(--fg-bone);
    line-height: 1.15;
  }
  .spotlight-meta {
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-graphite);
  }
  .about-mini__shuffler:hover .spotlight-cell {
    animation-play-state: paused;
  }
  /* No hover-locked opacity. The hover affordance is just colour on
     the caption (meta turns amber) and a pointer cursor; forcing the
     cell to opacity:1 would lift it above the fading-out neighbour
     and recreate the very crossfade-competition bug we're fixing. */
  .spotlight-cell:hover .spotlight-meta {
    color: var(--accent-amber);
