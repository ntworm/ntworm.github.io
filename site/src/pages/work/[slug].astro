---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getProjectMedia } from '../../utils/project-images';
import dimensionsData from '../../data/asset-dimensions.json';

interface Props {
  entry: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
  act: string;
  media: ReturnType<typeof getProjectMedia>;
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
      act: `ACT ${String(i + 1).padStart(2, '0')}`,
      media: getProjectMedia(entry.id),
    },
  }));
}

const { entry, prev, next, act, media } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const year = data.year ?? '';
const role = data.role ?? '';
const country = data.country ?? '';
const type = data.type ?? '';
const production = data.production ?? '';
const links = data.links ?? [];
const awards = data.awards ?? [];
const interactiveEmbed = data.interactiveEmbed ?? null;
const hideGallery = entry.id === 'kakofoni-orquestra' || data.hideGallery === true;

// Image dimension lookup so the cover + gallery size to each file's natural
// aspect ratio. Generated by scripts/asset-dimensions.mjs.
const dimsMap = (dimensionsData as Record<string, Array<{ file: string; w: number; h: number; type: 'image'|'video'; ar: string }>>)[entry.id] ?? [];
const dimFor = (filename: string) => dimsMap.find((d) => d.file === filename);
const fallbackAR = '16 / 9';

// Split gallery: first 2 before body, rest after. Interleaves visuals with
// the prose instead of dumping the gallery at the end.
const splitIdx = 2;

// Optional frontmatter `seasons:` array (e.g. for TV projects with multiple
// season posters that should render side-by-side at equal size). When
// present, replaces the cover and excludes the listed images from the
// gallery pool so they don't render twice.
const seasons = data.seasons ?? null;
const seasonFiles = new Set((seasons ?? []).map((s) => s.img));

const galleryItems = media.gallery
  .map((src, i) => {
    const filename = src.split('/').pop() ?? '';
    return { src, type: media.galleryTypes[i], filename, dim: dimFor(filename), visualIndex: i + 1 };
  })
  .filter((g) => !seasonFiles.has(g.filename));
const galleryTop = galleryItems.slice(0, splitIdx);
const galleryBottom = galleryItems.slice(splitIdx);

const coverFilename = media.cover?.split('/').pop() ?? '';
const coverDim = dimFor(coverFilename);
const coverAR = coverDim ? `${coverDim.w} / ${coverDim.h}` : fallbackAR;
const showCover = !seasons && !data.youtubeId && media.cover;

// Optional mini-catalog of sub-pieces (fxhashPieces). When present, render
// as a 2-col grid of cards at the bottom of the case page. Each card
// surfaces a thumb + title + description + external link. Designed for
// projects whose primary artefact is a list of pieces (e.g. fxhash).
const fxhashPieces = data.fxhashPieces ?? [];

function mediaStyle(dim?: { ar: string }) {
  return dim ? `aspect-ratio:${dim.ar};` : '';
}
---
<Layout title={data.title} description={`${data.title} — ${role} (${year})`} image={media.cover} type="article">
  <article class="case wrap">
    <header class="case__header">
      <span class="eyebrow case__act">{act}</span>
      <h1 class="case__title">{data.title}</h1>
      <p class="case__tagline">{role} · {year}</p>
    </header>

    {media.trailer && (
      <figure class="case__trailer">
        <video src={media.trailer} controls autoplay muted loop playsinline preload="metadata" data-case-motion-video />
      </figure>
    )}

    {data.youtubeId && (
      <figure class="case__cover case__cover--video">
        <iframe
          src={`https://www.youtube.com/embed/${data.youtubeId}?autoplay=1&mute=1&loop=1&playlist=${data.youtubeId}&rel=0`}
          title={`${data.title} — YouTube`}
          frameborder="0"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
        ></iframe>
      </figure>
    )}

    {seasons && (
      <section class="case__seasons" aria-label="Seasons">
        {seasons.map((s) => {
          const dim = dimFor(s.img);
          return (
            <figure class="case__season" style={mediaStyle(dim)}>
              <img
                src={`/work/${entry.id}/${s.img}`}
                alt={`${data.title} — ${s.label}`}
                loading="eager"
                width={dim?.w}
                height={dim?.h}
              />
              <figcaption class="mono">{s.label}</figcaption>
            </figure>
          );
        })}
      </section>
    )}

    <section class:list={['case__primary', interactiveEmbed && 'case__primary--split']}>
    {showCover && (
      <figure
        class:list={[
          'case__cover',
          `case__cover--${media.coverType}`,
          interactiveEmbed && 'case__cover--interactive',
        ]}
        style={`aspect-ratio:${coverAR};`}
        data-interactive-host={interactiveEmbed ? '' : undefined}
      >
        {media.coverType === 'video' ? (
          <video src={media.cover} controls autoplay muted loop playsinline preload="metadata" data-case-motion-video />
        ) : interactiveEmbed ? (
          <button
            class="case__interactive-launch"
            type="button"
            data-interactive-launch
            data-src={interactiveEmbed.url}
            data-title={interactiveEmbed.title}
            aria-label={interactiveEmbed.cta}
          >
            <img
              src={media.cover}
              alt={`${data.title} â€” cover`}
              loading="eager"
              width={coverDim?.w}
              height={coverDim?.h}
            />
            <span class="case__interactive-prompt">
              <span class="eyebrow">Live generative work</span>
              <strong data-interactive-label>{interactiveEmbed.cta}</strong>
            </span>
          </button>
          <p class="case__interactive-status" role="status" aria-live="polite" data-interactive-status></p>
        ) : (
          <img
            src={media.cover}
            alt={`${data.title} — cover`}
            loading="eager"
            width={coverDim?.w}
            height={coverDim?.h}
          />
        )}
      </figure>
    )}

    {!hideGallery && galleryTop.length > 0 && (
      <section class="case__gallery case__gallery--top" aria-label="Project visuals">
        {galleryTop.map((m) => (
          <figure class="case__gallery-item" style={mediaStyle(m.dim)}>
            {m.type === 'video' ? (
              <video src={m.src} controls preload="metadata" width={m.dim?.w} height={m.dim?.h} />
            ) : (
              <img src={m.src} alt={`${data.title} \u2014 project visual ${m.visualIndex}`} loading="lazy" width={m.dim?.w} height={m.dim?.h} />
            )}
          </figure>
        ))}
      </section>
    )}

    <aside class="case__meta" aria-label="Project metadata">
      <dl>
        {year && (<><dt>Year</dt><dd>{year}</dd></>)}
        {role && (<><dt>Role</dt><dd>{role}</dd></>)}
        {country && (<><dt>Country</dt><dd>{country}</dd></>)}
        {type && (<><dt>Type</dt><dd>{type}</dd></>)}
        {production && (<><dt>Production</dt><dd>{production}</dd></>)}
      </dl>
      {awards.length > 0 && (
        <div class="case__awards">
          <span class="eyebrow">Awards</span>
          <ul>
            {awards.map((a: string) => <li>{a}</li>)}
          </ul>
        </div>
      )}
      {links.length > 0 && (
        <div class="case__links">
          <span class="eyebrow">Links</span>
          <ul>
            {links.map((l: { url: string; label: string }) => (
              <li><a href={l.url} rel="noopener">{l.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
    </section>

    <div class="case__body">
      <Content />
    </div>

    {!hideGallery && galleryBottom.length > 0 && (
      <section class="case__gallery case__gallery--bottom" aria-label="More visuals">
        {galleryBottom.map((m) => (
          <figure class="case__gallery-item" style={mediaStyle(m.dim)}>
            {m.type === 'video' ? (
              <video src={m.src} controls preload="metadata" width={m.dim?.w} height={m.dim?.h} />
            ) : (
              <img src={m.src} alt={`${data.title} \u2014 project visual ${m.visualIndex}`} loading="lazy" width={m.dim?.w} height={m.dim?.h} />
            )}
          </figure>
        ))}
      </section>
    )}

    {fxhashPieces.length > 0 && (
      <section class="case__catalog" aria-label="Mini-catalog">
        <header class="case__catalog-header">
          <span class="eyebrow">Mini-catalog</span>
          <h2 class="case__catalog-title">{fxhashPieces.length} pieces</h2>
        </header>
        <ul class="case__catalog-grid">
          {fxhashPieces.map((p) => (
            <li class="case__catalog-item">
              <a class="case__catalog-link" href={p.url} target="_blank" rel="noopener noreferrer">
                <figure class="case__catalog-thumb" style={p.thumbAr ? `aspect-ratio:${p.thumbAr};` : ''}>
                  <img src={p.thumb} alt={`${p.title} — thumb`} loading="lazy" />
                </figure>
                <div class="case__catalog-body">
                  <h3 class="case__catalog-piece-title">{p.title}</h3>
                  {p.desc && <p class="case__catalog-desc">{p.desc}</p>}
                  <span class="case__catalog-cta">Open on fxhash ↗</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="case__nav" aria-label="Case navigation">
      {prev ? (
        <a href={`/work/${prev.id}`} class="case__nav-link case__nav-link--prev">
          <span class="mono">← Previous</span>
          <span class="case__nav-title">{prev.data.title}</span>
        </a>
      ) : <span></span>}
      <a href="/#work" class="case__nav-link case__nav-link--all">
        <span class="mono">All Work</span>
      </a>
      {next ? (
        <a href={`/work/${next.id}`} class="case__nav-link case__nav-link--next">
          <span class="mono">Next →</span>
          <span class="case__nav-title">{next.data.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </article>
</Layout>

<style>
  .case {
    padding-top: var(--s-8);
    padding-bottom: var(--s-10);
  }
  .case__header { margin-bottom: var(--s-8); max-width: 80%; }
  .case__act { display: block; margin-bottom: var(--s-4); }
  .case__title {
    font-size: var(--t-display);
    margin-bottom: var(--s-4);
  }
  .case__tagline {
    font-size: var(--t-h3);
    color: var(--muted-graphite);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .case__trailer {
    margin: 0 0 var(--s-7);
    background: var(--bg-noir);
    border: 1px solid var(--muted-graphite);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .case__trailer video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Seasons: paired cover images (e.g. TV project with S6 + S7 posters)
     rendered side by side at equal size via 2-col grid. Each season's
     aspect ratio is set inline from the manifest so the cells match the
     natural image dimensions. */
  .case__seasons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
    margin: 0 0 var(--s-7);
  }
  .case__season {
    margin: 0;
    background: var(--bg-noir);
    border: 1px solid var(--muted-graphite);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .case__season img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    flex: 1 1 auto;
  }
  .case__season figcaption {
    padding: var(--s-2) var(--s-3);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-graphite);
    background: var(--bg-noir);
    border-top: 1px solid var(--muted-graphite);
  }
  @media (max-width: 640px) {
    .case__seasons { grid-template-columns: 1fr; }
  }

  /* Interactive cases pair the live work with its metadata. Non-interactive
     cases keep the original document flow through display: contents. */
  .case__primary { display: contents; }
  .case__primary--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
    width: 100%;
    max-width: 820px;
    gap: var(--s-8);
    align-items: start;
    margin-bottom: var(--s-8);
  }
  .case__primary--split .case__cover {
    width: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
  }
  .case__primary--split .case__meta {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: var(--s-6);
    margin: 0;
  }
  .case__primary--split .case__meta dd + dt { margin-top: var(--s-3); }
  @media (max-width: 820px) {
    .case__primary--split {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }

  /* Cover sizes to the file's natural aspect ratio (set inline via
     style="aspect-ratio:W/H"). Capped to max-width 720px + max-height
     70vh so a tall portrait cover on a wide viewport doesn't push the
     body text off the first screen. */
  .case__cover {
    margin: 0 auto var(--s-7);
    background: var(--bg-noir);
    border: 1px solid var(--muted-graphite);
    overflow: hidden;
    max-width: min(100%, 720px);
    max-height: 70vh;
  }
  .case__cover img,
  .case__cover video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .case__cover iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .case__cover--interactive { position: relative; }
  .case__interactive-launch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--bg-noir);
    color: var(--fg-bone);
    cursor: pointer;
    overflow: hidden;
  }
  .case__interactive-launch img {
    transition: filter 320ms var(--ease-out), transform 520ms var(--ease-out);
  }
  .case__interactive-launch::after {
    content: "";
    position: absolute;
    inset: 52% 0 0;
    background: linear-gradient(to bottom, transparent, rgba(11, 11, 12, 0.88));
    pointer-events: none;
  }
  .case__interactive-launch:hover img,
  .case__interactive-launch:focus-visible img {
    filter: brightness(0.72) saturate(0.82);
    transform: scale(1.012);
  }
  .case__interactive-launch:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: -2px;
  }
  .case__interactive-prompt {
    position: absolute;
    z-index: 1;
    left: var(--s-4);
    right: var(--s-4);
    bottom: var(--s-4);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    text-align: left;
    pointer-events: none;
  }
  .case__interactive-prompt strong {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-amber);
  }
  :global(.case__interactive-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    opacity: 0;
    transition: opacity 280ms var(--ease-out);
  }
  :global(.case__interactive-frame.is-ready) { opacity: 1; }
  /* YouTube embeds: 16:9 aspect-ratio so the iframe doesn't collapse
     to its default 150px height. Without this, the container has no
     intrinsic height and the video renders squished. */
  .case__cover--video {
    aspect-ratio: 16 / 9;
  }

  .case__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--s-5);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--muted-graphite);
    border-bottom: 1px solid var(--muted-graphite);
    margin: var(--s-7) 0;
  }
  .case__meta dl { display: flex; flex-direction: column; gap: var(--s-1); }
  .case__meta dt {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted-graphite);
  }
  .case__meta dd {
    font-family: var(--font-body);
    font-size: var(--t-body-sm);
    color: var(--fg-bone);
  }
  .case__awards, .case__links {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .case__awards ul, .case__links ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .case__awards li, .case__links li {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--accent-amber);
  }
  .case__links a {
    color: var(--accent-amber);
    border-bottom: 1px solid var(--muted-graphite);
  }
  .case__links a:hover { color: var(--fg-bone); border-bottom-color: var(--accent-amber); }

  .case__body {
    max-width: 70ch;
    font-size: var(--t-body);
    line-height: 1.65;
  }
  .case__body :global(h2) {
    font-size: var(--t-h2);
    margin: var(--s-7) 0 var(--s-3);
  }
  .case__body :global(p) { margin-bottom: var(--s-4); }
  /* <em> in case bodies stays plain italic — project mentions get amber
     through .entity-link wrapping (see global.css), not via a blanket
     em→amber rule. Otherwise plain emphasized text (e.g. "what to leave
     out" on A.I. AM) reads amber even when it isn't a project link. */

  /* Gallery: each item's container sizes to its own image's natural AR
     (inline style="aspect-ratio:W/H"). Capped at max-height 70vh so a
     tall portrait cover doesn't dominate. Grid uses align-items:start
     so mismatched-row heights don't stretch siblings. */
  .case__gallery {
    margin: var(--s-7) 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
    align-items: start;
  }
  .case__gallery-item {
    margin: 0;
    background: var(--bg-noir);
    border: 1px solid var(--muted-graphite);
    overflow: hidden;
    max-width: 100%;
    max-height: 70vh;
  }
  .case__gallery-item img,
  .case__gallery-item video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  @media (max-width: 640px) {
    .case__gallery { grid-template-columns: 1fr; }
  }

  .case__nav {
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    border-top: 1px solid var(--muted-graphite);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--s-4);
    align-items: center;
  }
  .case__nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    border-bottom: 0;
  }
  .case__nav-link--prev { text-align: left; }
  .case__nav-link--all { text-align: center; }
  .case__nav-link--next { text-align: right; }
  .case__nav-link .mono { color: var(--muted-graphite); }
  .case__nav-title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    color: var(--fg-bone);
  }
  .case__nav-link:hover .case__nav-title { color: var(--accent-amber); }
  .case__nav-link:hover .mono { color: var(--accent-amber); }

  @media (max-width: 640px) {
    .case__header { max-width: 100%; }
    .case__nav { grid-template-columns: 1fr; text-align: left; }
    .case__nav-link--next, .case__nav-link--all { text-align: left; }
  }

  /* Mini-catalog: 2-col grid of sub-pieces. Each card has a square thumb,
     title, short description, and an external link. Used by fxhash and
     potentially other projects with multiple published pieces. The card
     link opens the external piece URL in a new tab. */
  .case__catalog {
    margin: var(--s-9) 0 0;
    padding-top: var(--s-6);
    border-top: 1px solid var(--muted-graphite);
  }
  .case__catalog-header {
    margin-bottom: var(--s-5);
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }
  .case__catalog-title {
    font-size: var(--t-h2);
    margin: 0;
  }
  .case__catalog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
    align-items: start;
  }
  .case__catalog-item { margin: 0; }
  .case__catalog-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    border-bottom: 0;
    color: inherit;
  }
  .case__catalog-thumb {
    margin: 0;
    background: var(--bg-noir);
    border: 1px solid var(--muted-graphite);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    transition: border-color 0.18s ease;
  }
  .case__catalog-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .case__catalog-link:hover .case__catalog-thumb { border-color: var(--accent-amber); }
  .case__catalog-body {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .case__catalog-piece-title {
    font-size: var(--t-h3);
    margin: 0;
    color: var(--fg-bone);
    transition: color 0.18s ease;
  }
  .case__catalog-desc {
    font-size: var(--t-body-sm);
    color: var(--muted-graphite);
    margin: 0;
    line-height: 1.5;
  }
  .case__catalog-cta {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-amber);
    margin-top: var(--s-2);
  }
  .case__catalog-link:hover .case__catalog-piece-title { color: var(--accent-amber); }
  @media (max-width: 640px) {
    .case__catalog-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  let disposeCaseMedia = () => {};

  function attachCaseMedia(): void {
    disposeCaseMedia();
    const cleanups: Array<() => void> = [];
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncReducedMotion = () => {
      if (!motionQuery.matches) return;

      document.querySelectorAll<HTMLVideoElement>('[data-case-motion-video]').forEach((video) => {
        video.autoplay = false;
        video.loop = false;
        video.pause();
      });
    };

    syncReducedMotion();
    motionQuery.addEventListener('change', syncReducedMotion);
    cleanups.push(() => motionQuery.removeEventListener('change', syncReducedMotion));

    document.querySelectorAll<HTMLButtonElement>('[data-interactive-launch]').forEach((button) => {
      const host = button.closest<HTMLElement>('[data-interactive-host]');
      const src = button.dataset.src;
      const label = button.querySelector<HTMLElement>('[data-interactive-label]');
      const status = host?.querySelector<HTMLElement>('[data-interactive-status]');
      if (!host || !src || !status) return;

      const initialLabel = label?.textContent ?? button.getAttribute('aria-label') ?? 'Open live work';
      let disposed = false;
      let attempt = 0;
      let timeoutId: number | undefined;
      let frame: HTMLIFrameElement | undefined;

      const clearPendingFrame = () => {
        if (timeoutId !== undefined) {
          window.clearTimeout(timeoutId);
          timeoutId = undefined;
        }
        frame?.remove();
        frame = undefined;
      };

      const restoreRetry = (token = attempt) => {
        if (disposed || token !== attempt) return;
        clearPendingFrame();
        host.removeAttribute('data-interactive-loaded');
        button.disabled = false;
        button.hidden = false;
        if (label) label.textContent = initialLabel;
        status.textContent = 'Could not load the live work. Try again.';
      };

      const launch = (event: MouseEvent) => {
        if (!event.isTrusted || button.disabled) return;

        const token = ++attempt;
        button.disabled = true;
        if (label) label.textContent = 'Loading live work...';
        status.textContent = 'Loading live work.';

        const nextFrame = document.createElement('iframe');
        frame = nextFrame;
        nextFrame.className = 'case__interactive-frame';
        nextFrame.src = src;
        nextFrame.title = button.dataset.title ?? 'Interactive artwork';
        nextFrame.tabIndex = 0;
        nextFrame.allow = 'autoplay; fullscreen';
        nextFrame.allowFullscreen = true;
        nextFrame.sandbox.add('allow-scripts', 'allow-same-origin');
        nextFrame.referrerPolicy = 'no-referrer';

        nextFrame.addEventListener('load', () => {
          if (disposed || token !== attempt || frame !== nextFrame) return;
          if (timeoutId !== undefined) {
            window.clearTimeout(timeoutId);
            timeoutId = undefined;
          }
          nextFrame.classList.add('is-ready');
          host.dataset.interactiveLoaded = 'true';
          button.hidden = true;
          status.textContent = 'Live work loaded.';
          requestAnimationFrame(() => {
            if (!disposed && token === attempt && nextFrame.isConnected) nextFrame.focus();
          });
        }, { once: true });
        nextFrame.addEventListener('error', () => restoreRetry(token), { once: true });
        timeoutId = window.setTimeout(() => restoreRetry(token), 12000);
        host.append(nextFrame);
      };

      button.addEventListener('click', launch);
      cleanups.push(() => {
        disposed = true;
        attempt += 1;
        button.removeEventListener('click', launch);
        clearPendingFrame();
        button.disabled = false;
        button.hidden = false;
        if (label) label.textContent = initialLabel;
      });
    });

    disposeCaseMedia = () => {
      cleanups.splice(0).forEach((cleanup) => cleanup());
      disposeCaseMedia = () => {};
    };
  }

  function attachInteractiveCases(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-interactive-launch]:not([data-interactive-bound])').forEach((button) => {
      button.dataset.interactiveBound = 'true';
      button.addEventListener('click', () => {
        const host = button.closest<HTMLElement>('[data-interactive-host]');
        const src = button.dataset.src;
        if (!host || !src) return;

        button.disabled = true;
        const label = button.querySelector<HTMLElement>('[data-interactive-label]');
        if (label) label.textContent = 'Loading live work…';

        const frame = document.createElement('iframe');
        frame.className = 'case__interactive-frame';
        frame.src = src;
        frame.title = button.dataset.title ?? 'Interactive artwork';
        frame.allow = 'autoplay; fullscreen';
        frame.allowFullscreen = true;
        frame.referrerPolicy = 'no-referrer';
        frame.addEventListener('load', () => {
          frame.classList.add('is-ready');
          button.hidden = true;
          host.dataset.interactiveLoaded = 'true';
        }, { once: true });
        host.append(frame);
      }, { once: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachCaseMedia, { once: true });
  } else {
    attachCaseMedia();
  }
  document.addEventListener('astro:page-load', attachCaseMedia);
  document.addEventListener('astro:before-swap', disposeCaseMedia);
</script>
