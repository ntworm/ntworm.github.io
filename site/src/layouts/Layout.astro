---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, LOCALE_META, alternatePaths, localeFromPath } from '../i18n/locales.mjs';
import { useTranslations } from '../i18n/ui.mjs';
import { buildCanonical } from '../utils/seo.mjs';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  /** Canonical URL for the page. Auto-derived from Astro.url when omitted. */
  canonicalUrl?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  mode?: 'standard' | 'continuous';
  immersive?: boolean;
}

const locale = localeFromPath(Astro.url);
const t = useTranslations(locale);
const {
  title,
  description = t('layout.description'),
  image = null,
  type = 'website',
  canonicalUrl,
  structuredData,
  mode = 'standard',
  immersive = false,
} = Astro.props;
const isContinuous = mode === 'continuous';
const isImmersive = immersive || isContinuous;

// Resolve absolute URL for og:image (social platforms need absolute URLs).
// Astro.site gives the configured site origin; on dev it falls back to localhost.
const siteOrigin = Astro.site?.origin ?? `${Astro.url.protocol}//${Astro.url.host}`;
const ogImage = image ? (image.startsWith('http') ? image : `${siteOrigin}${image}`) : null;
const cleanCanonicalUrl = buildCanonical(siteOrigin, canonicalUrl ?? Astro.url.pathname);
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null;
// Every page exists in both languages under the same path, so alternates
// are derived from the canonical path rather than passed in.
const alternates = alternatePaths(new URL(cleanCanonicalUrl).pathname);
---
<!DOCTYPE html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} &mdash; Gabriel Worm</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={cleanCanonicalUrl}>
    {LOCALES.map((alternate) => (
      <link rel="alternate" hreflang={LOCALE_META[alternate].hreflang} href={buildCanonical(siteOrigin, alternates[alternate])}>
    ))}
    <link rel="alternate" hreflang="x-default" href={buildCanonical(siteOrigin, alternates.en)}>
    <meta name="theme-color" content="#0B0B0C">
    <link rel="manifest" href="/site.webmanifest">
    {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}

    <!-- Open Graph -->
    <meta property="og:type" content={type}>
    <meta property="og:title" content={`${title} — Gabriel Worm`}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={cleanCanonicalUrl}>
    {ogImage && <meta property="og:image" content={ogImage}>}
    <meta property="og:site_name" content="Gabriel Worm">
    <meta property="og:locale" content={LOCALE_META[locale].ogLocale}>
    {LOCALES.filter((alternate) => alternate !== locale).map((alternate) => (
      <meta property="og:locale:alternate" content={LOCALE_META[alternate].ogLocale}>
    ))}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
    <meta name="twitter:title" content={`${title} — Gabriel Worm`}>
    <meta name="twitter:description" content={description}>
    {ogImage && <meta name="twitter:image" content={ogImage}>}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@500;700&family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body data-layout={mode} data-immersive={isImmersive ? 'true' : 'false'}>
    <div class="page-curtain" transition:persist></div>
    <a href="#main" class="skip-link">{t('layout.skip')}</a>
    <Nav />
    <main id="main"><slot /></main>
    {!isContinuous && <Footer />}
    <script>
      import '../scripts/scroll-fade.ts';
      import '../scripts/scroll-progress.ts';
      import '../scripts/title-reveal.ts';
    </script>
  </body>
</html>

<style>
  /* Page transition curtain — bymonolog/cobloc style.
     Ativa quando Astro ClientRouter troca de página. */
  .page-curtain {
    position: fixed;
    inset: 0;
    background: var(--bg-noir, #0B0B0C);
    z-index: 9999;
    pointer-events: none;
    transform: translateY(100%);
    transition: transform 0.55s cubic-bezier(0.76, 0, 0.24, 1);
  }
  /* Estado "carregando" — quando Astro começa swap, sobe */
  .page-curtain[data-loading] {
    transform: translateY(0);
  }
  /* Animação de entrada na página nova — desce revelando conteúdo */
  :global(body.swap-done) .page-curtain {
    transform: translateY(100%);
  }
  :global(body[data-immersive="true"] main) { padding-top: 0; }
  :global(body[data-layout="continuous"] main) { padding-bottom: 0; }
  @media (prefers-reduced-motion: reduce) {
    .page-curtain { transition: none; }
  }
</style>

<script>
  // Garante que o curtain desce após cada navegação SPA
  document.addEventListener('astro:after-swap', () => {
    document.body.classList.add('swap-done');
  });
</script>
